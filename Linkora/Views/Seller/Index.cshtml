@using Linkora.Models
@{
    var seller = (UserSummary)ViewBag.Seller;
    var products = (List<Product>)ViewBag.Products;
    var reviewCount = (int)ViewBag.ReviewCount;
    var reviewAvg = (double)ViewBag.ReviewAvg;
    var sort = (string)ViewBag.Sort;
    var activeCatId = (int?)ViewBag.CategoryId;
    var categories = (List<CategoryCount>)ViewBag.Categories;
    ViewData["Title"] = seller.UserName;
}

<div class="seller-header">
    <div class="seller-header-avatar">
        @if (seller.AvatarUrl != null)
        {
            <img src="@seller.AvatarUrl" onerror="this.src='/img/no-photo.svg'" />
        }
        else
        {
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
        }
    </div>
    <div class="seller-header-info">
        <div class="seller-header-name">
            @seller.UserName
            @if (seller.IsCompany)
            {
                <span class="seller-badge" data-i18n="company_badge">Company</span>
            }
        </div>
        @if (reviewCount > 0)
        {
            <button class="seller-header-rating" onclick="openReviews()">
                <span class="seller-stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24"
                             fill="@(i <= Math.Round(reviewAvg) ? "#f5a623" : "none")"
                             stroke="#f5a623" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                    }
                </span>
                <span class="seller-rating-val">@reviewAvg.ToString("F1")</span>
                <span class="seller-rating-count">
                    <span data-i18n="ratings_label">Ratings:</span> @reviewCount
                </span>
            </button>
        }
        <div class="seller-header-meta">
            <span data-i18n="member_since_label">Member since</span>
            <span>@(seller.CreatedAt?.ToString("MMMM yyyy") ?? "—")</span>
        </div>
    </div>
    <div class="seller-header-actions">
        <button class="seller-share-btn" onclick="navigator.clipboard.writeText(window.location.href)" title="Share" data-i18n-title="share">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="18" cy="5" r="3" />
                <circle cx="6" cy="12" r="3" />
                <circle cx="18" cy="19" r="3" />
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
            </svg>
        </button>

        <button class="seller-subscribe-btn"
                id="subscribeBtn"
                onclick="toggleSubscription(@seller.Id)"
                data-seller-id="@seller.Id">
            <span class="sub-icon">♡</span>
            <span class="sub-label" data-i18n="subscribe_btn">Subscribe</span>
            <span class="sub-count" id="subCount"></span>
        </button>
    </div>
</div>

<div class="category-body">
    <div class="category-left">
        <nav class="category-sidebar">
            <a class="sidebar-current @(activeCatId == null ? "sidebar-item-active" : "")"
               href="/Seller/Index/@seller.Id?sort=@sort" data-i18n="all_categories_side">All categories</a>
            @foreach (var cat in categories)
            {
                <a class="sidebar-child @(activeCatId == cat.Id ? "sidebar-item-active" : "")"
                   href="/Seller/Index/@seller.Id?categoryId=@cat.Id&sort=@sort">
                    @cat.Name
                    <span class="sidebar-cat-count">@cat.Count</span>
                </a>
            }
        </nav>
    </div>

    <div class="category-content">
        <div class="listing-toolbar">
            <div class="listing-view-btns">
                <button class="listing-view-btn" id="btnGrid" onclick="setView('grid')" title="Grid">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                </button>
                <button class="listing-view-btn" id="btnList" onclick="setView('list')" title="List">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="18" x2="21" y2="18" />
                    </svg>
                </button>
            </div>
            <div class="listing-sort-wrap">
                <button class="listing-sort-btn" onclick="toggleSort(event)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="7" y1="12" x2="21" y2="12" />
                        <line x1="11" y1="18" x2="21" y2="18" />
                    </svg>
                    <span id="sortLabel" data-sort="@sort"></span> ▾
                </button>
                <div class="listing-sort-drop" id="sortDrop">
                    <a class="listing-sort-item @(sort == "new" ? "active" : "")"
                       href="@Url.Action("Index", "Seller", new { id = seller.Id, categoryId = activeCatId, sort = "new", page = 1 })"
                       data-i18n="sort_newest"></a>
                    <a class="listing-sort-item @(sort == "cheap" ? "active" : "")"
                       href="@Url.Action("Index", "Seller", new { id = seller.Id, categoryId = activeCatId, sort = "cheap", page = 1 })"
                       data-i18n="sort_cheapest"></a>
                    <a class="listing-sort-item @(sort == "expensive" ? "active" : "")"
                       href="@Url.Action("Index", "Seller", new { id = seller.Id, categoryId = activeCatId, sort = "expensive", page = 1 })"
                       data-i18n="sort_expensive"></a>
                </div>
            </div>
        </div>

        <div class="listing-grid" id="listingContainer">
            @foreach (var p in products)
            {
                await Html.RenderPartialAsync("_ProductCard", new ProductCardViewModel { Product = p, ShowFavActions = false, ShowSeller = false });
            }
        </div>
        @if (ViewBag.TotalPages > 1)
        {
            var currentPage = (int)ViewBag.Page;
            var totalPages = (int)ViewBag.TotalPages;
            sort = ViewBag.Sort as string;
            var categoryId = ViewBag.CategoryId as int?;

            string GetPageUrl(int page)
            {
                return Url.Action("Index", "Seller", new { id = seller.Id, categoryId = categoryId, sort = sort, page = page });
            }

            <nav class="pagination">
                <ul class="pagination-list">
                    @if (currentPage > 1)
                    {
                        <li><a class="page-link" href="@GetPageUrl(currentPage - 1)">←</a></li>
                    }

                    @{
                        int around = 1;

                        if (totalPages <= 2 * around)
                        {
                            for (int i = 1; i <= totalPages; i++)
                            {
                                if (i == currentPage)
                                {
                                    <li><span class="page-link active">@i</span></li>
                                }
                                else
                                {
                                    <li><a class="page-link" href="@GetPageUrl(i)">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            if (currentPage == 1)
                            {
                                <li><span class="page-link active">1</span></li>
                            }
                            else
                            {
                                <li><a class="page-link" href="@GetPageUrl(1)">1</a></li>
                            }

                            if (currentPage > around + 2)
                            {
                                <li><span class="page-link dots">…</span></li>
                            }

                            int left = Math.Max(2, currentPage - around);
                            int right = Math.Min(totalPages - 1, currentPage + around);
                            for (int i = left; i <= right; i++)
                            {
                                if (i == currentPage)
                                {
                                    <li><span class="page-link active">@i</span></li>
                                }
                                else
                                {
                                    <li><a class="page-link" href="@GetPageUrl(i)">@i</a></li>
                                }
                            }

                            if (currentPage < totalPages - around - 1)
                            {
                                <li><span class="page-link dots">…</span></li>
                            }
                            if (currentPage == totalPages)
                            {
                                <li><span class="page-link active">@totalPages</span></li>
                            }
                            else
                            {
                                <li><a class="page-link" href="@GetPageUrl(totalPages)">@totalPages</a></li>
                            }
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <li><a class="page-link" href="@GetPageUrl(currentPage + 1)">→</a></li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@await Html.PartialAsync("Partial/_SellerReviewsModal")

<script>
    function t(key) {
        const lang = localStorage.getItem('lang') || 'en';
        const dict = (typeof TRANSLATIONS !== 'undefined' && (TRANSLATIONS[lang] || TRANSLATIONS['en'])) || {};
        return dict[key] || key;
    }

    function setView(v) {
        localStorage.setItem('listingView', v);
        const c = document.getElementById('listingContainer');
        c.className = v === 'grid' ? 'listing-grid' : 'listing-list';
        document.getElementById('btnGrid').classList.toggle('active', v === 'grid');
        document.getElementById('btnList').classList.toggle('active', v === 'list');
    }

    function toggleSort(e) {
        e.stopPropagation();
        document.getElementById('sortDrop').classList.toggle('open');
    }

    document.addEventListener('click', e => {
        if (!e.target.closest('.listing-sort-wrap'))
            document.getElementById('sortDrop').classList.remove('open');
    });

    function setSortLabel() {
        const label = document.getElementById('sortLabel');
        if (!label) return;
        const sortKey = label.dataset.sort || 'new';
        const map = {
            'new': 'sort_newest',
            'cheap': 'sort_cheapest',
            'expensive': 'sort_expensive'
        };
        label.textContent = translate(map[sortKey]) || translate('sort_newest');
    }

    function translatePage() {
        document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            if (key) {
                el.textContent = t(key);
            }
        });
        document.querySelectorAll('[data-i18n-title]').forEach(el => {
            const key = el.getAttribute('data-i18n-title');
            if (key) {
                el.title = t(key);
            }
        });

        setSortLabel();
    }

    function applySubscriptionState(subscribed, count) {
        const btn      = document.getElementById('subscribeBtn');
        const iconEl   = btn.querySelector('.sub-icon');
        const labelEl  = btn.querySelector('.sub-label');
        const countEl  = document.getElementById('subCount');

        btn.classList.toggle('subscribed', subscribed);
        iconEl.textContent  = subscribed ? '♥' : '♡';
        labelEl.textContent = subscribed ? translate('subscribed_btn') : translate('subscribe_btn');

        if (count > 0) {
            countEl.textContent = count;
            countEl.style.display = '';
        } else {
            countEl.style.display = 'none';
        }
    }

    async function loadSubscriptionState(sellerId) {
        try {
            const res  = await fetch(`/Subscription/State/${sellerId}`);
            const data = await res.json();
            applySubscriptionState(data.subscribed, data.count);
        } catch {}
    }

    async function toggleSubscription(sellerId) {
        if (!window.isUserAuthenticated) {
            if (typeof openAuthModal === 'function') {
                openAuthModal('login');
            }
            return;
        }
        const btn = document.getElementById('subscribeBtn');
        btn.disabled = true;

        try {
            const res = await fetch(`/Subscription/Toggle/${sellerId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken':
                        document.getElementById('afToken')?.value ?? ''
                }
            });

            if (!res.ok) {
                console.error(translate('subscription_toggle_failed'), res.status);
                return;
            }

            const data = await res.json();
            applySubscriptionState(data.subscribed, data.count);

            const icon = btn.querySelector('.sub-icon');
            icon.style.transform = 'scale(1.4)';
            setTimeout(() => icon.style.transform = '', 200);

        } catch (e) {
            console.error(translate('subscription_error'), e);
        } finally {
            btn.disabled = false;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        setView(localStorage.getItem('listingView') || 'grid');
        loadSubscriptionState(@seller.Id);
        translatePage();
        openReviewFromQuery();
    });

    function openReviewFromQuery() {
        const params = new URLSearchParams(window.location.search);
        const reviewId = params.get('reviewId');
        if (!reviewId) return;

        openReviews();

        const attemptScroll = () => {
            const el = document.querySelector(`.review-item[data-review-id="${reviewId}"]`);
            if (!el) return;
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.style.transition = 'background-color 0.3s';
            el.style.backgroundColor = '#fff7e0';
            setTimeout(() => { el.style.backgroundColor = ''; }, 2000);
        };

        setTimeout(attemptScroll, 100);
    }
    </script>