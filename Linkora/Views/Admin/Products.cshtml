@{
    var products = (List<AdminProductRow>)ViewBag.Products;
    var status = (string)ViewBag.Status;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var total = (int)ViewBag.Total;
    var search = (string?)ViewBag.Search;
    ViewData["Title"] = "Admin — Listings";

    string TabUrl(string s) => $"/Admin/Products?status={s}&page=1{(search != null ? "&search=" + Uri.EscapeDataString(search) : "")}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

<div class="admin-layout">
    @await Html.PartialAsync("Sidebar", "products")

    <main class="admin-main">
        <h1 class="admin-page-title">
            <span data-i18n="admin_listings">Listings</span>
            <span class="admin-page-subtitle">@total <span data-i18n="admin_results">results</span></span>
        </h1>

        <div class="admin-toolbar">
            <form method="get" action="/Admin/Products" style="display:flex;gap:8px;flex:1;max-width:340px">
                <input type="hidden" name="status" value="@status" />
                <div class="admin-search-wrap" style="max-width:100%;flex:1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input class="admin-search-input" name="search" value="@search"
                           data-i18n-placeholder="admin_search_by_name_ph" placeholder="Search by name..." />
                </div>
                <button type="submit" class="admin-btn admin-btn-primary" data-i18n="admin_search_btn">Search</button>
                @if (search != null)
                {
                    <a href="/Admin/Products?status=@status" class="admin-btn admin-btn-view">✕</a>
                }
            </form>

            <div class="admin-status-tabs">
                @foreach (var s in new[] { "Moderation", "Active", "Rejected", "Archived", "Succeeded" })
                {
                    <a class="admin-status-tab @(status == s ? "active" : "")"
                       href="@TabUrl(s)" data-i18n="admin_status_@(s.ToLower())">@s</a>
                }
            </div>
        </div>

        <div class="admin-card">
            @if (!products.Any())
            {
                <div class="admin-empty" data-i18n="admin_no_listings">No listings found</div>
            }
            else
            {
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th data-i18n="admin_listing_col">Listing</th>
                            <th data-i18n="admin_seller_col">Seller</th>
                            <th data-i18n="admin_price_col">Price</th>
                            <th data-i18n="admin_reports_col">Reports</th>
                            <th data-i18n="admin_date_col">Date</th>
                            <th data-i18n="admin_actions_col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in products)
                        {
                            <tr id="row-@p.Id">
                                <td>
                                    <div class="admin-table-product">
                                        @if (p.ImagePath != null)
                                        {
                                            <img class="admin-table-img" src="@p.ImagePath"
                                                 onerror="this.src='/img/no-photo.svg'" />
                                        }
                                        else
                                        {
                                            <div class="admin-table-img" style="display:flex;align-items:center;justify-content:center">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="2">
                                                    <rect x="3" y="3" width="18" height="18" rx="2" />
                                                    <circle cx="8.5" cy="8.5" r="1.5" />
                                                    <polyline points="21 15 16 10 5 21" />
                                                </svg>
                                            </div>
                                        }
                                        <div>
                                            <a class="admin-table-product-name"
                                               href="/Product/Details/@p.Id" target="_blank">@p.Name</a>
                                            <div class="admin-table-product-meta">#@p.Id</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a href="/Seller/Index/@p.UserId" target="_blank"
                                       style="color:#333;text-decoration:none;font-size:13px">
                                        @p.UserName
                                    </a>
                                </td>
                                <td style="font-weight:600">
                                    @(p.Price.HasValue? p.Price.Value.ToString("N2") + " €" : "—")
                                </td>
                                <td>
                                    @if (p.ReportCount > 0)
                                    {
                                        <span style="color:#c62828;font-weight:700">@p.ReportCount</span>
                                    }
                                    else
                                    {
                                        <span style="color:#ccc">0</span>
                                    }
                                </td>
                                <td style="color:#aaa;font-size:12px;white-space:nowrap">
                                    @(p.CreatedTime?.ToString("dd MMM yyyy"))
                                </td>
                                <td>
                                    <div class="admin-actions">
                                        @if (status == "Moderation" || status == "Rejected")
                                        {
                                            <button class="admin-btn admin-btn-approve"
                                                    onclick="setStatus(@p.Id, 'Active', this)">
                                                <span data-i18n="admin_approve">Approve</span>
                                            </button>
                                        }
                                        @if (status == "Moderation" || status == "Active")
                                        {
                                            <button class="admin-btn admin-btn-reject"
                                                    onclick="openRejectModal(@p.Id)">
                                                <span data-i18n="admin_reject">Reject</span>
                                            </button>
                                        }
                                        @if (status == "Archived")
                                        {
                                            <button class="admin-btn admin-btn-restore"
                                                    onclick="setStatus(@p.Id, 'Active', this)">
                                                <span data-i18n="admin_restore">Restore</span>
                                            </button>
                                        }
                                        <button class="admin-btn admin-btn-danger"
                                                onclick="confirmDelete(@p.Id, '@p.Name.Replace("'", "\\'")')">
                                            <span data-i18n="admin_delete">Delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (totalPages > 1)
                {
                    <div class="admin-pagination">
                        @if (page > 1)
                        {
                            <a class="admin-page-btn" href="/Admin/Products?status=@status&page=@(page - 1)&search=@search">‹</a>
                        }
                        @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                        {
                            <a class="admin-page-btn @(i == page ? "active" : "")"
                               href="/Admin/Products?status=@status&page=@i&search=@search">@i</a>
                        }
                        @if (page < totalPages)
                        {
                            <a class="admin-page-btn" href="/Admin/Products?status=@status&page=@(page + 1)&search=@search">›</a>
                        }
                    </div>
                }
            }
        </div>
    </main>
</div>

<div class="admin-confirm-overlay" id="confirmOverlay">
    <div class="admin-confirm-box">
        <div class="admin-confirm-title" data-i18n="admin_confirm_delete_listing">Delete listing?</div>
        <div class="admin-confirm-text" id="confirmText"></div>
        <div class="admin-confirm-actions">
            <button class="admin-btn admin-btn-view" onclick="closeConfirm()" data-i18n="admin_cancel_btn">Cancel</button>
            <button class="admin-btn admin-btn-danger" id="confirmOk" data-i18n="admin_delete">Delete</button>
        </div>
    </div>
</div>
<div class="modal-overlay" id="rejectOverlay" onclick="closeRejectModal()"></div>
<div class="modal" id="rejectModal">
    <button class="modal-close" onclick="closeRejectModal()">✕</button>
    <h2 class="auth-title" data-i18n="admin_reject_modal_title">Reject listing</h2>
    <div class="auth-field">
        <label class="auth-label" data-i18n="report_reason_label">Reason</label>
        <select class="auth-input" id="rejectReasonSelect">
            <option value="" data-i18n="report_reason_ph">Select a reason</option>
        </select>
    </div>
    <div class="auth-field">
        <label class="auth-label" data-i18n="report_comment_label">Comment (optional)</label>
        <textarea class="auth-input" id="rejectComment" rows="3"></textarea>
    </div>
    <div class="auth-actions" style="display:flex; gap:12px;">
        <button class="admin-btn admin-btn-reject" onclick="submitRejectProduct()" data-i18n="admin_reject">Reject</button>
        <button class="admin-btn admin-btn-view" onclick="closeRejectModal()" data-i18n="admin_cancel_btn">Cancel</button>
    </div>
</div>
<div class="admin-toast" id="toast"></div>

@section Scripts {
    <script>
                let rejectReasons = [];
        let currentRejectProductId = null;

        async function openRejectModal(productId) {
            currentRejectProductId = productId;
            if (!rejectReasons.length) {
                const res = await fetch('/api/Report/reasons');
                if (res.ok) rejectReasons = await res.json();
            }
            const select = document.getElementById('rejectReasonSelect');
            select.innerHTML = `<option value="">${t('report_reason_ph')}</option>`;
            rejectReasons.forEach(r => {
                const opt = document.createElement('option');
                opt.value = r.id;
                opt.textContent = r.text;
                select.appendChild(opt);
            });
            document.getElementById('rejectComment').value = '';
            document.getElementById('rejectOverlay').classList.add('modal-open');
            document.getElementById('rejectModal').classList.add('modal-open');
        }

        function closeRejectModal() {
            document.getElementById('rejectOverlay').classList.remove('modal-open');
            document.getElementById('rejectModal').classList.remove('modal-open');
        }

        async function submitRejectProduct() {
            const reasonId = document.getElementById('rejectReasonSelect').value;
            if (!reasonId) return;

            const comment = document.getElementById('rejectComment').value;
            const res = await fetch(
                `/Admin/RejectProductWithReason?id=${currentRejectProductId}&reasonId=${reasonId}&comment=${encodeURIComponent(comment)}`,
                { method: 'POST', headers: { 'RequestVerificationToken': afToken } }
            );

            if (res.ok) {
                closeRejectModal();
                document.getElementById('row-' + currentRejectProductId)?.remove();
                showToast(getJsText('status_updated') + 'Rejected', 'success');
            } else {
                showToast(getJsText('err_status'), 'error');
            }
        }
        const afToken = document.getElementById('afToken')?.value ?? '';

        const jsLangs = {
            en: {
                status_updated: 'Status updated to ',
                err_status: 'Error updating status',
                confirm_question: 'Are you sure you want to delete "{name}"? This cannot be undone.',
                deleted_success: 'Listing deleted',
                err_delete: 'Error deleting listing'
            },
            lv: {
                status_updated: 'Statuss atjaunots uz ',
                err_status: 'Kļūda, atjaunojot statusu',
                confirm_question: 'Vai tiešām vēlaties dzēst "{name}"? Šo darbību nevarēs atcelt.',
                deleted_success: 'Sludinājums izdzēsts',
                err_delete: 'Kļūda, dzēšot sludinājumu'
            },
            ru: {
                status_updated: 'Статус обновлен на ',
                err_status: 'Ошибка обновления статуса',
                confirm_question: 'Вы уверены, что хотите удалить "{name}"? Это действие нельзя отменить.',
                deleted_success: 'Sludinājums izdzēsts',
                err_delete: 'Ошибка удаления объявления'
            }
        };

        function getJsText(key) {
            const currentLang = localStorage.getItem('lang') || 'en';
            return jsLangs[currentLang]?.[key] || jsLangs['en'][key];
        }

        async function setStatus(id, status, btn) {
            btn.disabled = true;
            const res = await fetch(`/Admin/SetProductStatus?id=${id}&status=${status}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': afToken }
            });
            if (res.ok) {
                document.getElementById('row-' + id)?.remove();
                showToast(getJsText('status_updated') + status, 'success');
            } else {
                showToast(getJsText('err_status'), 'error');
                btn.disabled = false;
            }
        }

        let deleteId = null;
        function confirmDelete(id, name) {
            deleteId = id;
            document.getElementById('confirmText').textContent = getJsText('confirm_question').replace('{name}', name);
            document.getElementById('confirmOverlay').classList.add('open');
            document.getElementById('confirmOk').onclick = doDelete;
        }

        function closeConfirm() {
            document.getElementById('confirmOverlay').classList.remove('open');
        }

        async function doDelete() {
            closeConfirm();
            const res = await fetch(`/Product/Delete?id=${deleteId}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': afToken }
            });
            if (res.ok) {
                document.getElementById('row-' + deleteId)?.remove();
                showToast(getJsText('deleted_success'), 'success');
            } else {
                showToast(getJsText('err_delete'), 'error');
            }
        }

        function showToast(msg, type = 'success') {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className = `admin-toast ${type} show`;
            setTimeout(() => t.className = 'admin-toast', 2500);
        }

        document.getElementById('confirmOverlay').addEventListener('click', e => {
            if (e.target === e.currentTarget) closeConfirm();
        });
        document.addEventListener('DOMContentLoaded', applyTranslations);
    </script>
}