@using Linkora.Models
@using System.Globalization
@{
    var options = (List<AdminConfOptionRow>)ViewBag.Options;
    var total = (int)ViewBag.Total;
    ViewData["Title"] = "Admin — Parameter Confirmation";

    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();

    string Localized(string defaultVal, string? lvVal = null, string? ruVal = null)
    {
        return currentCulture switch
        {
            "lv" => lvVal ?? defaultVal,
            "ru" => ruVal ?? defaultVal,
            _ => defaultVal
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

<div class="admin-layout">
    @await Html.PartialAsync("Sidebar", "conf-options")

    <main class="admin-main">
        <h1 class="admin-page-title">
            <span data-i18n="admin_conf_options">Option Confirmation</span>
            <span class="admin-page-subtitle">@total <span data-i18n="admin_results">results</span></span>
        </h1>

        <div class="admin-card">
            @if (!options.Any())
            {
                <div class="admin-empty" data-i18n="admin_no_options">No unconfirmed options found</div>
            }
            else
            {
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th data-i18n="admin_listing_col">Listing</th>
                            <th data-i18n="admin_author_col">Author</th>
                            <th data-i18n="admin_category_param_col">Category / Parameter</th>
                            <th data-i18n="admin_option_value_col">Option Value</th>
                            <th data-i18n="admin_date_col">Date</th>
                            <th data-i18n="admin_actions_col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in options)
                        {
                            <tr id="row-@o.OptionId">
                                <td>
                                    <div>
                                        <a class="admin-table-product-name" href="/Product/Details/@o.ProductId" target="_blank">
                                            @Localized(o.ProductName)
                                        </a>
                                        <div class="admin-table-product-meta">#@o.ProductId</div>
                                    </div>
                                </td>
                                <td>
                                    <a href="/Seller/Index/@o.UserId" target="_blank" style="color:#333;text-decoration:none;font-size:13px">
                                        @Localized(o.UserName)
                                    </a>
                                </td>
                                <td>
                                    <span style="font-size:13px; color:#555;">
                                        @Localized(o.CategoryName, o.CategoryNameLV, o.CategoryNameRU)
                                        /
                                        @Localized(o.ParameterName, o.ParameterNameLV, o.ParameterNameRU)
                                    </span>
                                </td>
                                <td>
                                    <span style="font-size:13px; color:#333;">
                                        @Localized(o.OptionValue, o.OptionValueLV, o.OptionValueRU)
                                    </span>
                                </td>
                                <td style="color:#aaa;font-size:12px;white-space:nowrap">
                                    @(o.ProductCreatedTime?.ToString("dd MMM yyyy"))
                                </td>
                                <td>
                                    <div class="admin-actions">
                                        <button class="admin-btn admin-btn-approve" onclick="approveOption(@o.OptionId, this)">
                                            <span data-i18n="admin_approve">Approve</span>
                                        </button>
                                        <button class="admin-btn admin-btn-danger" onclick="rejectProduct(@o.OptionId, @o.ProductId, this)">
                                            <span data-i18n="admin_reject">Reject Ad</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </main>
</div>

<div class="admin-toast" id="toast"></div>

@section Scripts {
    <script>
        (function extendTranslations() {
            const extra = {
                en: {
                    'admin_no_options': 'No unconfirmed options found',
                    'admin_option_value_col': 'Option Value',
                    'approved': 'Option approved successfully',
                    'rejected': 'Product blocked and option removed',
                    'err_action': 'Error processing request',
                    'confirm_reject': 'Are you sure you want to block this listing?'
                },
                lv: {
                    'admin_no_options': 'Nav neatpazītu opciju',
                    'admin_option_value_col': 'Opcijas vērtība',
                    'approved': 'Apstiprināts veiksmīgi',
                    'rejected': 'Sludinājums bloķēts',
                    'err_action': 'Kļūda, izpildot pieprasījumu',
                    'confirm_reject': 'Vai tiešām vēlaties bloķēt šo sludinājumu?'
                },
                ru: {
                    'admin_no_options': 'Неподтвержденных опций не найдено',
                    'admin_option_value_col': 'Значение опции',
                    'approved': 'Параметр успешно подтвержден',
                    'rejected': 'Объявление заблокировано',
                    'err_action': 'Ошибка выполнения операции',
                    'confirm_reject': 'Вы уверены, что хотите заблокировать это объявление?'
                }
            };

            if (typeof TRANSLATIONS !== 'undefined') {
                for (const lang in extra) {
                    if (!TRANSLATIONS[lang]) TRANSLATIONS[lang] = {};
                    for (const key in extra[lang]) {
                        if (!TRANSLATIONS[lang][key]) {
                            TRANSLATIONS[lang][key] = extra[lang][key];
                        }
                    }
                }
            }
        })();

        const afToken = document.getElementById('afToken')?.value ?? '';

        async function approveOption(optionId, btn) {
            btn.disabled = true;
            const res = await fetch(`/Admin/ApproveOption?id=${optionId}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': afToken }
            });
            if (res.ok) {
                document.getElementById('row-' + optionId)?.remove();
                showToast(t('approved'), 'success');
            } else {
                showToast(t('err_action'), 'error');
                btn.disabled = false;
            }
        }

        async function rejectProduct(optionId, productId, btn) {
            if (!confirm(t('confirm_reject'))) {
                return;
            }
            btn.disabled = true;
            const res = await fetch(`/Admin/RejectProductByOption?optionId=${optionId}&productId=${productId}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': afToken }
            });
            if (res.ok) {
                document.getElementById('row-' + optionId)?.remove();
                showToast(t('rejected'), 'success');
            } else {
                showToast(t('err_action'), 'error');
                btn.disabled = false;
            }
        }

        function showToast(msg, type = 'success') {
            const tEl = document.getElementById('toast');
            tEl.textContent = msg;
            tEl.className = `admin-toast ${type} show`;
            setTimeout(() => tEl.className = 'admin-toast', 2500);
        }

        window.approveOption = approveOption;
        window.rejectProduct = rejectProduct;

        if (typeof applyTranslations === 'function') {
            if (document.readyState === 'complete') {
                applyTranslations();
            } else {
                document.addEventListener('DOMContentLoaded', applyTranslations);
            }
        }
    </script>
}