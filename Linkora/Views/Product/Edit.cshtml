@using Linkora.Models
@{
    var p = (Product)ViewBag.Product;
    ViewData["Title"] = "Edit ad";
}

<div class="create-page">
    <h1 class="create-title" data-i18n="edit_ad_title">Edit ad</h1>
    <div class="create-body">
        <div class="create-form">
            <div class="create-section">
                <h2 class="create-section-title" data-i18n="basic_info">Basic information</h2>
                <div class="create-field">
                    <h2 class="create-section-title" data-i18n="category_section">Category</h2>
                    <div class="create-cat-selector" id="catSelector" onclick="openCatMenuForEdit()">
                        <span id="catSelectorText" data-i18n="select_category">@(p.CategoryId.HasValue ? "Change category" : "Select category")</span>
                        <span class="create-cat-arrow">›</span>
                    </div>
                    <input type="hidden" id="selectedCategoryId" value="@p.CategoryId" />
                </div>

                <div class="create-field">
                    <label class="create-label" data-i18n="title_label">Title</label>
                    <input type="text" class="create-input" id="adTitle" value="@p.Name" placeholder="What are you selling?" data-i18n-placeholder="title_ph" />
                </div>
                <div class="create-field">
                    <label class="create-label" data-i18n="desc_label">Description</label>
                    <textarea class="create-input create-textarea" id="adDescription" placeholder="Describe the item" data-i18n-placeholder="desc_ph">@p.Description</textarea>
                </div>

                <div class="create-field" id="priceFieldWrap" style="display:none">
                    <label class="create-label" data-i18n="price_label">Price</label>
                    <input type="number" class="create-input" id="adPrice" min="0" placeholder="0.00" />
                </div>

                <div class="create-row" id="qtyRow">
                    <div class="create-field" id="qtyFieldWrap" style="grid-column: 1 / -1">
                        <label class="create-label" data-i18n="qty_label">Quantity</label>
                        <input type="number" class="create-input" id="adQty" min="1" value="@(p.Qty ?? 1)" />
                    </div>
                </div>

                <div class="create-field">
                    <label class="create-label" data-i18n="city_label">City</label>
                    <input type="text" class="create-input create-autocomplete" id="adCity"
                           placeholder="Start typing..." autocomplete="off"
                           oninput="addressSearch(this,'city')"
                           onfocus="addressSearch(this,'city')" data-i18n-placeholder="city_ph" />
                    <input type="hidden" id="adCityId" />
                    <div class="create-dropdown" id="adCityDrop"></div>
                </div>
                <div class="create-field" id="streetField" style="display:none">
                    <label class="create-label" data-i18n="street_label">Street</label>
                    <input type="text" class="create-input create-autocomplete" id="adStreet"
                           placeholder="Start typing..." autocomplete="off"
                           oninput="addressSearch(this,'street')"
                           onfocus="addressSearch(this,'street')" data-i18n-placeholder="city_ph" />
                    <input type="hidden" id="adStreetId" />
                    <div class="create-dropdown" id="adStreetDrop"></div>
                </div>
                <div class="create-field" id="houseField" style="display:none">
                    <label class="create-label" data-i18n="house_label">House</label>
                    <input type="text" class="create-input create-autocomplete" id="adHouse"
                           placeholder="Start typing..." autocomplete="off"
                           oninput="addressSearch(this,'house')"
                           onfocus="addressSearch(this,'house')" data-i18n-placeholder="city_ph" />
                    <input type="hidden" id="adHouseId" />
                    <div class="create-dropdown" id="adHouseDrop"></div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty((string)ViewBag.UserHomeAddress))
            {
                <div class="create-field" style="flex-direction:row;align-items:center;gap:8px">
                    <input type="checkbox" id="useHomeAddress"
                           checked="@((bool)ViewBag.IsUsingHomeAddress)"
                           onchange="toggleHomeAddress()" />
                    <label for="useHomeAddress" style="margin:0" data-i18n="use_home_address_label">
                        Use my saved address: @ViewBag.UserHomeAddress
                    </label>
                </div>
            }
            <div class="create-section" id="paramsSection" style="display:none">
                <h2 class="create-section-title" data-i18n="params_section">Parameters</h2>
                <div class="create-params" id="createParams"></div>
            </div>

            <div class="create-section">
                <h2 class="create-section-title" data-i18n="photos_section">Photos & Video</h2>
                <div class="create-photos-area" id="photosArea"
                     onclick="document.getElementById('photoInput').click()">
                    <div class="create-photos-placeholder">
                        <span class="create-photos-icon">📷</span>
                        <span>Click to upload photos or video</span>
                        <span class="create-photos-hint" data-i18n="photos_hint">Images & video · Max 50 MB total</span>
                    </div>
                    <input type="file" id="photoInput" multiple
                           accept="image/*,video/mp4,video/webm,video/quicktime"
                           style="display:none" onchange="previewPhotos(this)" />
                </div>
                <div class="create-size-bar" id="sizeBar" style="display:none">
                    <div class="create-size-fill" id="sizeFill"></div>
                    <span class="create-size-label" id="sizeLabel"></span>
                </div>
                <div class="create-photos-preview" id="photosPreview"></div>
            </div>

            <div class="create-section">
                <div class="auth-field">
                    <label class="auth-label" data-i18n="ad_duration_label">Publication duration</label>
                    <div class="duration-pills" id="pubDurationPills"></div>
                    <input type="hidden" id="pubDurationValue" value="30" />
                </div>
            </div>
            <div class="create-section">
                <div class="auth-field">
                    <label class="auth-label" data-i18n="promotion_label">Promote your listing</label>
                    <div class="duration-pills" id="promotionPills">
                        @foreach (var promo in new[] { "None", "Highlight", "Top", "Vip" })
                        {
                            var isActive = p.PromotionType == promo;
                            <button type="button"
                                    class="duration-pill @(isActive ? "active" : "")"
                                    data-type="@promo"
                                    onclick="selectPromotion('@promo', this)"
                                    data-i18n="promo_@(promo.ToLower())">
                                @promo
                            </button>
                        }
                    </div>
                    <div class="duration-hint" data-i18n="promotion_hint">
                        No paid promotion applied by default.
                    </div>
                    <input type="hidden" id="promotionValue" value="@p.PromotionType" />
                </div>
            </div>

            <div class="create-footer-sticky">
                <button class="create-submit" onclick="submitEdit(@p.Id)" data-i18n="save_btn">Save</button>
            </div>
        </div>
    </div>

    <partial name="~/Views/Shared/Partial/_PromoRulesModal.cshtml" model="@("promo")" />
</div>

<script src="~/js/param-rules-engine.js"></script>
<script src="~/js/product-form.js"></script>
<script src="~/js/param-utils.js"></script>
<script>
    async function restoreEditDraft(state) {
        const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ''; };

        setVal('adTitle', state.title);
        setVal('adDescription', state.description);
        setVal('adQty', state.qty || '1');

        setVal('adCity', state.city);
        setVal('adCityId', state.cityId);
        setVal('adStreet', state.street);
        setVal('adStreetId', state.streetId);
        setVal('adHouse', state.house);
        setVal('adHouseId', state.houseId);

        if (state.cityId) document.getElementById('streetField').style.display = 'block';
        if (state.streetId) document.getElementById('houseField').style.display = 'block';

        if (state.categoryId) {
            document.getElementById('selectedCategoryId').value = state.categoryId;

            const serverCatName = '@Html.Raw(ViewBag.CategoryName ?? "")';
            if (String(state.categoryId) === String(@p.CategoryId) && serverCatName) {
                document.getElementById('catSelectorText').textContent = serverCatName;
            } else {
                document.getElementById('catSelectorText').textContent = state.categoryText || '';
            }

            await loadParams(state.categoryId, state.params || {});
        }

        if (state.publishDays) {
            setVal('pubDurationValue', state.publishDays);
        }
    }

    window.addEventListener('DOMContentLoaded', async () => {
        const productId = @p.Id;
        const draftKey = 'linkora_edit_draft_' + productId;
        const draftRaw = sessionStorage.getItem(draftKey);
        toggleHomeAddress();
        if (draftRaw) {
            sessionStorage.removeItem(draftKey);
            window.draftRestored = true;
            await restoreEditDraft(JSON.parse(draftRaw));
            await loadExistingMedia(productId);
            return;
        }

        const catId = document.getElementById('selectedCategoryId').value;
        const catName = '@Html.Raw(ViewBag.CategoryName ?? "")';
        if (catName) {
            document.getElementById('catSelectorText').textContent = catName;
        }

        if (catId) {
            const valRes = await fetch(`/Product/ParamValues?productId=${productId}`);
            const values = await valRes.json();
            await loadParams(catId, values);
        }

        await loadExistingMedia(productId);
    });

    window.beforeLangChange = async function () {
        const params = await collectParamValues();
        sessionStorage.setItem('linkora_edit_draft_' + @p.Id, JSON.stringify({
            title: document.getElementById('adTitle')?.value,
            description: document.getElementById('adDescription')?.value,
            qty: document.getElementById('adQty')?.value,
            city: document.getElementById('adCity')?.value,
            cityId: document.getElementById('adCityId')?.value,
            street: document.getElementById('adStreet')?.value,
            streetId: document.getElementById('adStreetId')?.value,
            house: document.getElementById('adHouse')?.value,
            houseId: document.getElementById('adHouseId')?.value,
            categoryId: document.getElementById('selectedCategoryId')?.value,
            categoryText: document.getElementById('catSelectorText')?.textContent,
            publishDays: document.getElementById('pubDurationValue')?.value,
            params: params,
        }));
    };

    async function loadExistingMedia(productId) {
        try {
            const res = await fetch(`/Product/MediaFiles?productId=${productId}`);
            if (!res.ok) return;
            const media = await res.json();
            if (!media.length) return;

            const preview = document.getElementById('photosPreview');

            media.forEach(item => {
                const wrap = document.createElement('div');
                wrap.className = 'create-photo-thumb';
                wrap.dataset.existingPath = item.filePath;

                if (item.mediaType === 'video') {
                    wrap.innerHTML = `
                        <video src="${item.filePath}" class="thumb-video" muted playsinline
                               onmouseenter="this.play()" onmouseleave="this.pause();this.currentTime=0"></video>
                        <div class="thumb-video-badge">▶</div>
                        <button type="button" onclick="removeExisting(this)">✕</button>`;
                } else {
                    wrap.innerHTML = `
                        <img src="${item.filePath}" onerror="this.src='/img/no-photo.svg'" />
                        <button type="button" onclick="removeExisting(this)">✕</button>`;
                }
                preview.appendChild(wrap);
            });

            window.existingMediaPaths = media.map(m => m.filePath);
        } catch (e) {
            console.error(translate('failed_load_media'), e);
        }
    }

    function removeExisting(btn) {
        const wrap = btn.parentElement;
        const path = wrap.dataset.existingPath;
        if (window.existingMediaPaths) {
            window.existingMediaPaths = window.existingMediaPaths.filter(p => p !== path);
        }
        wrap.remove();
    }

    window.onPromoAgree = async function(type, btn) {
        const res = await fetch('/Payments/InitiatePromotion', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: `productId=@p.Id&promotionType=${type}`
        });
        if (res.ok) {
            const data = await res.json();
            window.location.href = data.redirectUrl;
        } else {
            alert('Payment initiation failed');
        }
    };

    async function submitEdit(id) {
        if (!ParamRulesEngine.validateAll()) return;
        const btn = document.querySelector('.create-submit');
        btn.disabled = true;

        const lang = localStorage.getItem('lang') || 'en';
        const dict = TRANSLATIONS[lang] || TRANSLATIONS['en'];
        btn.textContent = dict['saving'] || 'Saving...';

        try {
            const totalBytes = selectedFiles.reduce((s, f) => s + f.size, 0);
            if (totalBytes > MAX_BYTES) {
                alert(translate('media_size_exceeded'));
                return;
            }

            const priceWrap = document.getElementById('priceFieldWrap');
            if (priceWrap.style.display !== 'none') {
                const priceVal = document.getElementById('adPrice').value;
                if (priceVal) fd.append('price', priceVal);
            }

            const useHome = document.getElementById('useHomeAddress')?.checked === true;
            let addressValue;

            if (useHome) {
                addressValue = '@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.UserHomeAddress ?? ""))';
            } else {
                const addressParts = ['adCity', 'adStreet', 'adHouse']
                    .map(id => document.getElementById(id)?.value?.trim())
                    .filter(Boolean);
                addressValue = addressParts.join(', ');
            }

            const fd = new FormData();
            fd.append('title', document.getElementById('adTitle').value);
            fd.append('description', document.getElementById('adDescription').value);
            fd.append('qty', document.getElementById('adQty').value || '1');
            fd.append('address', addressValue);
            fd.append('useHomeAddress', useHome);
            fd.append('categoryId', document.getElementById('selectedCategoryId').value);
            fd.append('keepMediaJson', JSON.stringify(window.existingMediaPaths || []));
            fd.append('publishDays', document.getElementById('pubDurationValue').value || '30');
            fd.append('promotionType', document.getElementById('promotionValue').value || 'None');

            const params = await collectParamValues(document.getElementById('createParams'));
            fd.append('paramsJson', JSON.stringify(params));

            for (const file of selectedFiles) fd.append('photos', file);

            const res = await fetch(`/Product/Edit?id=${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.getElementById('afToken')?.value ?? '' },
                body: fd
            });

            if (res.ok) {
                window.location.href = '/Product/My';
            } else {
                alert(translate('error') + ': ' + await res.text());
            }
        } catch (e) {
            alert(translate('network_error') + ': ' + e.message);
        } finally {
            btn.disabled = false;
            translateDynamicElement(btn);
        }
    }
        function toggleHomeAddress() {
        const checked = document.getElementById('useHomeAddress')?.checked;
        ['adCity', 'adStreet', 'adHouse'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.disabled = checked;
        });
    }
</script>