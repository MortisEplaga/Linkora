        const originalOpenTermsModal = window.openTermsModal;
        const originalOpenSupportModal = window.openSupportModal;

        window.openFaqModal = function() {
            if (originalOpenFaqModal) originalOpenFaqModal();
            else {
                document.getElementById('faqOverlay')?.classList.add('modal-open');
                document.getElementById('faqModal')?.classList.add('modal-open');
                document.body.style.overflow = 'hidden';
            }
            const lang = getCurrentLanguage();
            const modal = document.getElementById('faqModal');
            if (modal) {
                const buttons = modal.querySelectorAll('.info-lang-btn');
                for (let btn of buttons) {
                    const btnLang = btn.textContent.trim().toUpperCase();
                    if ((lang === 'ru' && btnLang === 'RU') ||
                        (lang === 'lv' && btnLang === 'LV') ||
                        (lang === 'en' && btnLang === 'EN')) {
                        switchInfoLang(lang, btn);
                        break;
                    }
                }
            }
        };

