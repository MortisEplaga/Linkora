<script src="https://www.google.com/recaptcha/api.js?render=explicit" async defer></script>

<div class="modal-overlay" id="captchaOverlay" onclick="closeCaptchaModal()"></div>
<div class="modal" id="captchaModal" style="max-width:360px" data-sitekey="@ViewBag.RecaptchaSiteKey">
    <button class="modal-close" onclick="closeCaptchaModal()">✕</button>
    <h2 class="auth-title" data-i18n="captcha_title">Verify you're human</h2>
    <p style="font-size:14px;color:#555;margin-bottom:16px" data-i18n="captcha_desc">
        Complete the verification to see the phone number.
    </p>
    <div id="recaptchaWidget"></div>
    <div id="captchaError" style="display:none;font-size:13px;color:#cc0000;margin:8px 0">
        Verification failed. Try again.
    </div>
    <button class="auth-submit" style="margin-top:16px" onclick="verifyCaptcha()" data-i18n="captcha_confirm_btn">Confirm</button>
</div>