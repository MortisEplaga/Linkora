<header class="site-header">

    @* ── Top navigation bar ── *@
    <div class="header-nav sticky-top" id="header-nav">
        <nav class="navbar">
            <div class="navbar-inner">

                <div class="offcanvas offcanvas-start" id="offcanvasMenu" tabindex="-1">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" data-i18n="my_ads">Menu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <ul class="nav-links">
                            <li><a class="nav-link" asp-controller="Home" asp-action="Index" data-i18n="for_business">For business</a></li>
                            <li><a class="nav-link" asp-controller="Home" asp-action="Index" data-i18n="career">Career</a></li>
                            <li><a class="nav-link" asp-controller="Home" asp-action="Index" data-i18n="help">Help</a></li>
                        </ul>
                    </div>
                </div>

                <div class="header-actions">

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <div class="user-menu-wrap">
                            @{
                                var avatarPath = User.FindFirst("Avatar")?.Value;
                            }
                            <div class="user-info-wrapper">
                                <button class="login-btn" onclick="toggleUserMenu()">
                                    @if (avatarPath != null)
                                    {
                                        <img src="@avatarPath" class="header-user-avatar" />
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                            <circle cx="12" cy="7" r="4" />
                                        </svg>
                                    }
                                    @User.Identity.Name
                                    </button>
                                <!-- Notification Bell -->
                                <div class="notif-wrap" id="notifWrap">
                                    <button class="login-btn notif-bell-btn" onclick="toggleNotifModal(event)" title="Notifications">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                                        </svg>
                                        <span class="notif-badge" id="notifBadge" style="display:none"></span>
                                    </button>
                                </div>
                            </div>

                            <div class="user-dropdown" id="userDropdown">
                                <div class="user-dropdown-header">
                                    <div class="user-dropdown-name">@User.Identity.Name</div>
                                    @if (User.IsInRole("admin") || User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "admin")
                                    {
                                        <a class="user-dropdown-item" href="/Admin/Index">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-user-icon lucide-shield-user"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="M6.376 18.91a6 6 0 0 1 11.249.003" /><circle cx="12" cy="11" r="4" /></svg>
                                        </a>
                                    }
                                    <!-- Notification Modal -->
                                    <div class="notif-overlay" id="notifOverlay" onclick="closeNotifModal()"></div>
                                    <div class="notif-modal" id="notifModal">
                                        <div class="notif-modal-header">
                                            <span class="notif-modal-title" data-i18n="notifications">Notifications</span>
                                            <div style="display:flex;align-items:center;gap:8px">
                                                <button class="notif-mark-all-btn" onclick="markAllReadModal()" id="markAllBtn" data-i18n="notif_mark_all_read">
                                                    Mark all as read
                                                </button>
                                                <button class="notif-modal-close" onclick="closeNotifModal()">✕</button>
                                            </div>
                                        </div>
                                        <div class="notif-tabs">
                                            <button class="notif-tab notif-tab-active" id="tabAll" onclick="switchNotifTab('all')">All</button>
                                            <button class="notif-tab" id="tabUnread" onclick="switchNotifTab('unread')" data-i18n="notif_no_unread">
                                                Unread <span class="notif-tab-count" id="tabUnreadCount" style="display:none"></span>
                                            </button>
                                        </div>
                                        <div class="notif-modal-list" id="notifModalList">
                                            <div class="notif-modal-empty">Loading...</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="user-dropdown-divider"></div>
                                <a class="user-dropdown-item" asp-controller="Product" asp-action="My">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                                    <span data-i18n="my_ads">My ads</span>
                                </a>
                                <a class="user-dropdown-item" href="/Messages/Index">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                    </svg>
                                    <span data-i18n="messages">Messages</span>
                                    <span class="msg-nav-badge" id="msgNavBadge" style="display:none;margin-left:auto"></span>
                                </a>
                                <a class="user-dropdown-item" asp-controller="Favourite" asp-action="Index" asp-route-tab="favs">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                                    <span data-i18n="favourites">Favourites</span>
                                    <span class="msg-nav-badge" id="favsNavBadge" style="display:none;margin-left:auto"></span>
                                </a>
                                <a class="user-dropdown-item" href="/Subscription/Index">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path class="cls-1" d="M1,22.74V2.05c0-.58.58-1.05,1.29-1.05h15.43c.71,0,1.29.47,1.29,1.05v20.69c0,.48-.74.71-1.13.35l-7.87-7.34-7.87,7.34c-.39.36-1.13.14-1.13-.35Z" />
                                    </svg>
                                    <span data-i18n="my_subscriptions">My subscriptions</span>
                                </a>
                                <a class="user-dropdown-item" onclick="openMyReviewsModal()" style="cursor:pointer">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                    </svg>
                                    <span data-i18n="reviews">Reviews</span>
                                </a>
                                <div class="user-dropdown-divider"></div>
                                <a class="user-dropdown-item" asp-controller="Favourite" asp-action="Index" asp-route-tab="cart">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                                    <span data-i18n="cart">Cart</span>
                                    <span class="msg-nav-badge" id="cartNavBadge" style="display:none;margin-left:auto"></span>
                                </a>
                                <div class="user-dropdown-divider"></div>
                                <a class="user-dropdown-item" onclick="openSettingsModal()" style="cursor:pointer">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="3" />
                                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                                    </svg>
                                    <span data-i18n="settings">Settings</span>
                                </a>
                                <a class="user-dropdown-item user-dropdown-logout" asp-controller="Account" asp-action="Logout">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                                    <span data-i18n="logout">Logout</span>
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="login-btn" onclick="openAuthModal('login')">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            <span data-i18n="sign_in_btn">Sign in</span>
                        </button>
                    }
                    <span class="divider">|</span>
                    <div class="lang-switcher">
                        <button class="lang-pill" id="headerLangEN" onclick="setLang('en')">EN</button>
                        <button class="lang-pill" id="headerLangLV" onclick="setLang('lv')">LV</button>
                        <button class="lang-pill" id="headerLangRU" onclick="setLang('ru')">RU</button>
                    </div>

                </div>

            </div>
        </nav>
    </div>

    @* ── Search bar ── *@
    <div class="header-search-bar">
        <div class="header-search-inner">

            <a asp-controller="Home" asp-action="Index" class="site-logo">
                <img src="/img/Logo.svg" alt="Linkora24" width="175" />
            </a>

            <button type="button" class="categories-btn" onclick="openCatMenu()">
                <img src="/img/search_for.svg" alt="" class="categories-icon" />
                <span data-i18n="all_categories">All categories</span>
            </button>

            <form class="search-form" onsubmit="handleGlobalSearch(event)">
                <div class="search-pill">
                    <input type="text" class="search-input"
                           name="search"
                           placeholder="Search..."
                           data-i18n-placeholder="search_placeholder"
                           aria-label="Search" />
                    <button type="submit" class="search-btn" data-i18n="search_btn">Search</button>
                </div>
            </form>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Product" asp-action="Create" class="header-post-btn">
                    <span data-i18n="post_ad_btn">+ Post an ad</span>
                </a>
            }
            else
            {
                <button type="button" class="header-post-btn" onclick="openAuthModal('login')">
                    <span data-i18n="post_ad_btn">+ Post an ad</span>
                </button>
            }
        </div>
    </div>

    @if (User.Identity!.IsAuthenticated)
    {
        <!-- Settings Modal (language section removed) -->
        <div class="modal-overlay" id="settingsOverlay" onclick="closeSettingsModal()"></div>
        <div class="modal" id="settingsModal" style="max-width:360px;width:360px;height:auto;min-height:unset;padding-bottom:24px">
            <button class="modal-close" onclick="closeSettingsModal()">✕</button>
            <h2 class="auth-title" data-i18n="settings_title">Settings</h2>

            <div class="settings-section">
                <div class="settings-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    </svg>
                    <span data-i18n="settings_dark">Dark mode</span>
                </div>
                <button class="settings-toggle" id="themeToggle" onclick="toggleTheme()">
                    <span class="settings-toggle-knob"></span>
                </button>
                <div class="settings-section">
                    <div class="settings-label">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <span data-i18n="profile_settings_link">Profile settings</span>
                    </div>
                    <a href="/Profile/Edit" onclick="closeSettingsModal()"
                       style="font-size:13px;color:#00b0a3;font-weight:600;text-decoration:none" data-i18n="profile_edit_title">
                        Edit →
                    </a>
                </div>
            </div>
        </div>

        <!-- Reviews Modal -->
        <div class="reviews-overlay" id="myReviewsOverlay" onclick="closeMyReviewsModal()"></div>
        <div class="reviews-modal" id="myReviewsModal">
            <div class="reviews-modal-header">
                <span class="reviews-modal-title" data-i18n="reviews_title">Reviews</span>
                <button class="reviews-modal-close" onclick="closeMyReviewsModal()">✕</button>
            </div>
            <div class="reviews-tabs">
                <button class="reviews-tab reviews-tab-active" id="tabAboutMe"
                        onclick="switchReviewTab('about')"
                        data-i18n="about_me_tab">
                    About me
                </button>
                <button class="reviews-tab" id="tabFromMe"
                        onclick="switchReviewTab('from')"
                        data-i18n="from_me_tab">
                    From me
                </button>
            </div>
            <div class="reviews-list" id="myReviewsList">
                <div class="reviews-empty" data-i18n="loading_text">Loading...</div>
            </div>
        </div>
    }

   <script>
        function applyTranslations() {
            const lang = localStorage.getItem('lang') || 'en';
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                const translation = translations[lang]?.[key];
                if (translation) {
                    if (el.tagName === 'INPUT' && el.getAttribute('data-i18n-placeholder') !== null) {
                        el.placeholder = translation;
                    } else {
                        el.innerText = translation;
                    }
                }
            });
        }

        function setLang(lang) {
            localStorage.setItem('lang', lang);
            document.cookie = `lang=${lang};path=/;max-age=31536000`;
            applyTranslations();

            // Update active state in header switcher
            document.querySelectorAll('.lang-pill').forEach(btn => btn.classList.remove('active'));
            if (lang === 'en') document.getElementById('headerLangEN')?.classList.add('active');
            if (lang === 'lv') document.getElementById('headerLangLV')?.classList.add('active');
            if (lang === 'ru') document.getElementById('headerLangRU')?.classList.add('active');

            // Also update region button label if present
            const regionBtnLabel = document.getElementById('regionBtnLabel');
            if (regionBtnLabel && (regionBtnLabel.textContent === 'All regions' || regionBtnLabel.textContent === 'Visi reģioni' || regionBtnLabel.textContent === 'Все регионы')) {
                regionBtnLabel.textContent = t('all_regions');
            }
            location.reload();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark-theme');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            const themeToggleBtn = document.getElementById('themeToggle');
            if (themeToggleBtn) themeToggleBtn.classList.toggle('settings-toggle-on', isDark);
        }

        // Apply theme on load
        (function() {
            if (localStorage.getItem('theme') === 'dark')
                document.documentElement.classList.add('dark-theme');

            // Set active language pill in header
            const currentLang = localStorage.getItem('lang') || 'en';
            if (currentLang === 'en') document.getElementById('headerLangEN')?.classList.add('active');
            if (currentLang === 'lv') document.getElementById('headerLangLV')?.classList.add('active');
            if (currentLang === 'ru') document.getElementById('headerLangRU')?.classList.add('active');
        })();

        function t(key) {
            const lang = localStorage.getItem('lang') || 'en';
            return translations[lang]?.[key] || key;
        }

        const translations = {
            en: {
                notif_new_listing: "{0} posted a new listing: {1}",
                all_regions: "All regions",
                loading_text: "Loading...",
                no_reviews_yet: "No reviews yet.",
                failed_load: "Failed to load.",
                notifications: "Notifications",
                notif_no_unread: "Unread",
                notif_mark_all_read: "Mark all as read",
                settings_title: "Settings",
                settings_dark: "Dark mode",
                my_ads: "My ads",
                messages: "Messages",
                favourites: "Favourites",
                my_subscriptions: "My subscriptions",
                reviews: "Reviews",
                cart: "Cart",
                logout: "Logout",
                sign_in_btn: "Sign in",
                for_business: "For business",
                career: "Career",
                help: "Help",
                all_categories: "All categories",
                search_placeholder: "Search...",
                search_btn: "Search",
                post_ad_btn: "+ Post an ad",
                about_me_tab: "About me",
                from_me_tab: "From me",
                reviews_title: "Reviews",
                settings_language: "Language"  
            },
            lv: {
                notif_new_listing: "{0} publicēja jaunu sludinājumu: {1}",
                all_regions: "Visi reģioni",
                loading_text: "Ielādē...",
                no_reviews_yet: "Nav atsauksmju.",
                failed_load: "Neizdevās ielādēt.",
                notifications: "Paziņojumi",
                notif_no_unread: "Nelasīti",
                notif_mark_all_read: "Atzīmēt visus kā lasītus",
                settings_title: "Iestatījumi",
                settings_dark: "Tumšais režīms",
                my_ads: "Mani sludinājumi",
                messages: "Ziņas",
                favourites: "Iecienītie",
                my_subscriptions: "Mani abonementi",
                reviews: "Atsauksmes",
                cart: "Grozs",
                logout: "Iziet",
                sign_in_btn: "Pierakstīties",
                for_business: "Uzņēmējiem",
                career: "Karjera",
                help: "Palīdzība",
                all_categories: "Visas kategorijas",
                search_placeholder: "Meklēt...",
                search_btn: "Meklēt",
                post_ad_btn: "+ Pievienot sludinājumu",
                about_me_tab: "Par mani",
                from_me_tab: "No manis",
                reviews_title: "Atsauksmes",
                settings_language: "Valoda"
            },
            ru: {
                notif_new_listing: "{0} опубликовал новое объявление: {1}",
                all_regions: "Все регионы",
                loading_text: "Загрузка...",
                no_reviews_yet: "Нет отзывов.",
                failed_load: "Не удалось загрузить.",
                notifications: "Уведомления",
                notif_no_unread: "Непрочитанные",
                notif_mark_all_read: "Отметить все как прочитанные",
                settings_title: "Настройки",
                settings_dark: "Тёмная тема",
                my_ads: "Мои объявления",
                messages: "Сообщения",
                favourites: "Избранное",
                my_subscriptions: "Мои подписки",
                reviews: "Отзывы",
                cart: "Корзина",
                logout: "Выйти",
                sign_in_btn: "Войти",
                for_business: "Для бизнеса",
                career: "Карьера",
                help: "Помощь",
                all_categories: "Все категории",
                search_placeholder: "Поиск...",
                search_btn: "Найти",
                post_ad_btn: "+ Подать объявление",
                about_me_tab: "Обо мне",
                from_me_tab: "От меня",
                reviews_title: "Отзывы",
                settings_language: "Язык"
            }
        };

        let notifAllData = [];
        let notifCurrentTab = 'all';
        let notifModalOpen = false;

        function toggleNotifModal(e) {
            if (!document.getElementById('notifOverlay')) return;
            e.stopPropagation();
            if (notifModalOpen) {
                closeNotifModal();
            } else {
                openNotifModal();
            }
        }

        async function openNotifModal() {
            if (!document.getElementById('notifOverlay')) return;
            notifModalOpen = true;
            document.getElementById('notifOverlay').classList.add('open');
            document.getElementById('notifModal').classList.add('open');
            await loadAllNotifications();
        }

        function closeNotifModal() {
            if (!document.getElementById('notifOverlay')) return;
            notifModalOpen = false;
            document.getElementById('notifOverlay').classList.remove('open');
            document.getElementById('notifModal').classList.remove('open');
        }

        async function loadAllNotifications() {
            const list = document.getElementById('notifModalList');
            if (!list) return;
            list.innerHTML = '<div class="notif-modal-empty"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ddd" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>Loading...</div>';
            try {
                const res  = await fetch('/Notifications/List');
                notifAllData = await res.json();
                renderNotifList();
                updateNotifBadge(notifAllData.filter(n => !n.isRead).length);
            } catch {
                list.innerHTML = '<div class="notif-modal-empty">Failed to load</div>';
            }
        }

        function renderNotifList() {
            const list = document.getElementById('notifModalList');
            if (!list) return;
            const unreadCount = notifAllData.filter(n => !n.isRead).length;

            const tabCount = document.getElementById('tabUnreadCount');
            if (tabCount) {
                if (unreadCount > 0) {
                    tabCount.textContent = unreadCount;
                    tabCount.style.display = 'inline-block';
                } else {
                    tabCount.style.display = 'none';
                }
            }
            const markAllBtn = document.getElementById('markAllBtn');
            if (markAllBtn) markAllBtn.style.display = unreadCount > 0 ? '' : 'none';

            const data = notifCurrentTab === 'unread'
                ? notifAllData.filter(n => !n.isRead)
                : notifAllData;

            if (!data.length) {
                list.innerHTML = `
                    <div class="notif-modal-empty">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ddd" stroke-width="1.5">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        ${notifCurrentTab === 'unread' ? 'No unread notifications' : 'No notifications yet'}
                    </div>`;
                return;
            }

            list.innerHTML = data.map(n => `
                <div class="notif-item ${n.isRead ? '' : 'unread'}"
                     id="notif-item-${n.id}"
                     onclick="handleNotifClick(${n.id}, '${n.productId ? '/Product/Details/' + n.productId : ''}')">
                    <img class="notif-item-avatar"
                         src="${n.fromUserAvatar || '/img/no-photo.svg'}"
                         onerror="this.src='/img/no-photo.svg'" />
                    <div class="notif-item-body">
                        <div class="notif-item-msg">${escapeHtml(translateNotificationMessage(n.message))}</div>
                        <div class="notif-item-time">${n.createdAt}</div>
                        ${n.productId && n.productName ? `
                            <div class="notif-item-product">
                                ${n.productImage ? `<img src="${n.productImage}" onerror="this.src='/img/no-photo.svg'" />` : ''}
                                <span>${escapeHtml(n.productName)}</span>
                            </div>` : ''}
                    </div>
                </div>`
            ).join('');
        }

        async function handleNotifClick(id, url) {
            const item = notifAllData.find(n => n.id === id);
            if (!item) return;

            if (!item.isRead) {
                item.isRead = true;
                await fetch(`/Notifications/MarkRead?id=${id}`, { method: 'POST' });
                const unreadLeft = notifAllData.filter(n => !n.isRead).length;
                updateNotifBadge(unreadLeft);

                const el = document.getElementById('notif-item-' + id);
                if (el) {
                    el.classList.remove('unread');
                    if (notifCurrentTab === 'unread') {
                        el.style.transition = 'opacity 0.3s, max-height 0.3s';
                        el.style.opacity = '0';
                        el.style.overflow = 'hidden';
                        setTimeout(() => {
                            el.style.maxHeight = el.offsetHeight + 'px';
                            el.style.maxHeight = '0';
                            el.style.padding = '0';
                            setTimeout(() => renderNotifList(), 300);
                        }, 50);
                    } else {
                        const tabCount = document.getElementById('tabUnreadCount');
                        if (unreadLeft > 0) tabCount.textContent = unreadLeft;
                        else tabCount.style.display = 'none';
                        const markAllBtn = document.getElementById('markAllBtn');
                        if (markAllBtn) markAllBtn.style.display = unreadLeft > 0 ? '' : 'none';
                    }
                }
            }

            if (url) {
                closeNotifModal();
                window.location.href = url;
            }
        }

        function switchNotifTab(tab) {
            notifCurrentTab = tab;
            const tabAll = document.getElementById('tabAll');
            const tabUnread = document.getElementById('tabUnread');
            if (tabAll) tabAll.classList.toggle('notif-tab-active', tab === 'all');
            if (tabUnread) tabUnread.classList.toggle('notif-tab-active', tab === 'unread');
            renderNotifList();
        }

        async function markAllReadModal() {
            await fetch('/Notifications/MarkAllRead', { method: 'POST' });
            notifAllData.forEach(n => n.isRead = true);
            updateNotifBadge(0);
            renderNotifList();
        }

        function updateNotifBadge(count) {
            const badge = document.getElementById('notifBadge');
            if (!badge) return;
            badge.textContent = count;
            badge.style.display = count > 0 ? 'flex' : 'none';
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && notifModalOpen) closeNotifModal();
        });

        (async () => {
            if (document.getElementById('notifBadge')) {
                try {
                    const res = await fetch('/Notifications/Count');
                    if (!res.ok) return;
                    const { count } = await res.json();
                    updateNotifBadge(count);
                } catch {}
            }
        })();

        // ---------- Settings modal (logged-in only) ----------
        function openSettingsModal() {
            if (!document.getElementById('settingsOverlay')) return;
            document.getElementById('userDropdown')?.classList.remove('open');
            applySettingsUI();
            document.getElementById('settingsOverlay').classList.add('modal-open');
            document.getElementById('settingsModal').classList.add('modal-open');
            applyTranslations();
        }
        function closeSettingsModal() {
            if (!document.getElementById('settingsOverlay')) return;
            document.getElementById('settingsOverlay').classList.remove('modal-open');
            document.getElementById('settingsModal').classList.remove('modal-open');
        }
        function applySettingsUI() {
            const dark = localStorage.getItem('theme') === 'dark';
            const themeToggle = document.getElementById('themeToggle');
            if (themeToggle) themeToggle.classList.toggle('settings-toggle-on', dark);
        }

        // ---------- Reviews modal (logged-in only) ----------
        async function openMyReviewsModal() {
            if (!document.getElementById('myReviewsOverlay')) return;
            document.getElementById('userDropdown')?.classList.remove('open');
            document.getElementById('myReviewsOverlay').classList.add('open');
            document.getElementById('myReviewsModal').classList.add('open');
            applyTranslations();
            await loadReviewTab('about');
        }
        function closeMyReviewsModal() {
            if (!document.getElementById('myReviewsOverlay')) return;
            document.getElementById('myReviewsOverlay').classList.remove('open');
            document.getElementById('myReviewsModal').classList.remove('open');
        }
        async function switchReviewTab(tab) {
            const tabAbout = document.getElementById('tabAboutMe');
            const tabFrom = document.getElementById('tabFromMe');
            if (tabAbout) tabAbout.classList.toggle('reviews-tab-active', tab === 'about');
            if (tabFrom) tabFrom.classList.toggle('reviews-tab-active', tab === 'from');
            await loadReviewTab(tab);
        }
        async function loadReviewTab(tab) {
            const list = document.getElementById('myReviewsList');
            if (!list) return;
            list.innerHTML = `<div class="reviews-empty">${t('loading_text')}</div>`;
            try {
                const res  = await fetch(`/Reviews/My?tab=${tab}`);
                const data = await res.json();
                if (!data.length) {
                    list.innerHTML = `<div class="reviews-empty">${t('no_reviews_yet')}</div>`;
                    return;
                }
                list.innerHTML = data.map(r => `
                    <div class="review-item">
                        <div class="review-author">
                            <img src="${r.avatarPath || '/img/no-photo.svg'}"
                                 class="review-author-avatar"
                                 onerror="this.src='/img/no-photo.svg'" />
                            <div>
                                <a class="review-author-name" href="/Seller/Index/${r.userId}"
                                   onclick="closeMyReviewsModal()">
                                    ${r.userName}
                                </a>
                                <div class="review-date">${r.createdAt}</div>
                            </div>
                        </div>
                        <div class="review-stars">
                            ${[1,2,3,4,5,7,8].map(i =>
                                `<svg width="14" height="14" viewBox="0 0 24 24"
                                      fill="${i <= r.rating ? '#f5a623' : 'none'}"
                                      stroke="#f5a623" stroke-width="2">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                 </svg>`
                            ).join('')}
                        </div>
                        ${r.comment ? `<div class="review-comment">${r.comment}</div>` : ''}
                    </div>`
                ).join('');
            } catch {
                list.innerHTML = `<div class="reviews-empty">${t('failed_load')}</div>`;
            }
        }

        // ---------- Search handler ----------
        function handleGlobalSearch(e) {
            e.preventDefault();
            const input = e.target.querySelector('.search-input');
            const q = input?.value.trim();
            if (!q) return;

            const match = window.location.pathname.match(/\/Category\/Index\/(\d+)/i);
            if (match) {
                const url = new URL(window.location.href);
                url.searchParams.set('q', q);
                window.location.href = url.toString();
            } else {
                window.location.href = '/Category/Index/3711?q=' + encodeURIComponent(q);
            }
        }

        // Apply translations after DOM ready
        document.addEventListener('DOMContentLoaded', applyTranslations);

                function translateNotificationMessage(message) {
            const lang = localStorage.getItem('lang') || 'en';
            const pattern = /^(.+?) posted a new listing: (.+)$/;
            const match = message.match(pattern);
            if (match && translations[lang] && translations[lang]["notif_new_listing"]) {
                const author = match[1];
                const product = match[2];
                const template = translations[lang]["notif_new_listing"];
                return template.replace("{0}", author).replace("{1}", product);
            }
            return message; 
        }
    </script>
</header>