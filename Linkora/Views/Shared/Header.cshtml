<header class="site-header">

    @* ── Top navigation bar ── *@
    <div class="header-nav sticky-top" id="header-nav">
        <nav class="navbar">
            <div class="navbar-inner">

                <div class="offcanvas offcanvas-start" id="offcanvasMenu" tabindex="-1">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" data-i18n="my_ads">Menu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <ul class="nav-links">
                            <li><a class="nav-link" asp-controller="Home" asp-action="Index" data-i18n="for_business">For business</a></li>
                            <li><a class="nav-link" asp-controller="Home" asp-action="Index" data-i18n="career">Career</a></li>
                            <li><a class="nav-link" asp-controller="Home" asp-action="Index" data-i18n="help">Help</a></li>
                        </ul>
                    </div>
                </div>

                <div class="header-actions">

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <div class="user-menu-wrap">
                            @{
                                var avatarPath = User.FindFirst("Avatar")?.Value;
                            }
                            <div class="user-info-wrapper">
                                <button class="login-btn" onclick="toggleUserMenu()">
                                    @if (avatarPath != null)
                                    {
                                        <img src="@avatarPath" class="header-user-avatar" />
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                            <circle cx="12" cy="7" r="4" />
                                        </svg>
                                    }
                                    @User.Identity.Name
                                </button>
                                <!-- Notification Bell -->
                                <div class="notif-wrap" id="notifWrap">
                                    <button class="login-btn notif-bell-btn" onclick="toggleNotifModal(event)" title="Notifications">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                                        </svg>
                                        <span class="notif-badge" id="notifBadge" style="display:none"></span>
                                    </button>
                                </div>
                                <!-- Cart Icon (moved from dropdown) -->
                                <a asp-controller="Favourite" asp-action="Index" asp-route-tab="cart" class="login-btn cart-btn" title="Cart">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="9" cy="21" r="1" />
                                        <circle cx="20" cy="21" r="1" />
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                                    </svg>
                                    <span class="msg-nav-badge" id="cartNavBadge" style="display:none;margin-left:auto"></span>
                                </a>
                            </div>

                            <div class="user-dropdown" id="userDropdown">
                                <div class="user-dropdown-header">
                                    <div class="user-dropdown-name">@User.Identity.Name</div>
                                    @if (User.IsInRole("admin") || User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "admin")
                                    {
                                        <a class="user-dropdown-item" href="/Admin/Index">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-user-icon lucide-shield-user"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="M6.376 18.91a6 6 0 0 1 11.249.003" /><circle cx="12" cy="11" r="4" /></svg>
                                        </a>
                                    }
                                </div>
                                <div class="user-dropdown-divider"></div>
                                <a class="user-dropdown-item" asp-controller="Product" asp-action="My">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                                    <span data-i18n="my_ads">My ads</span>
                                </a>
                                <a class="user-dropdown-item" href="/Messages/Index">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                    </svg>
                                    <span data-i18n="messages">Messages</span>
                                    <span class="msg-nav-badge" id="msgNavBadge" style="display:none;margin-left:auto"></span>
                                </a>
                                <a class="user-dropdown-item" asp-controller="Favourite" asp-action="Index" asp-route-tab="favs">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                                    <span data-i18n="favourites">Favourites</span>
                                    <span class="msg-nav-badge" id="favsNavBadge" style="display:none;margin-left:auto"></span>
                                </a>
                                <a class="user-dropdown-item" href="/Subscription/Index">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path class="cls-1" d="M1,22.74V2.05c0-.58.58-1.05,1.29-1.05h15.43c.71,0,1.29.47,1.29,1.05v20.69c0,.48-.74.71-1.13.35l-7.87-7.34-7.87,7.34c-.39.36-1.13.14-1.13-.35Z" />
                                    </svg>
                                    <span data-i18n="my_subscriptions">My subscriptions</span>
                                </a>
                                <a class="user-dropdown-item" onclick="openMyReviewsModal()" style="cursor:pointer">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                    </svg>
                                    <span data-i18n="reviews">Reviews</span>
                                </a>
                                <div class="user-dropdown-divider"></div>
                                <!-- Cart link removed from here -->
                                <div class="user-dropdown-divider"></div>
                                <a class="user-dropdown-item" onclick="openSettingsModal()" style="cursor:pointer">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="3" />
                                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                                    </svg>
                                    <span data-i18n="settings">Settings</span>
                                </a>
                                <a class="user-dropdown-item user-dropdown-logout" asp-controller="Account" asp-action="Logout">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                                    <span data-i18n="logout">Logout</span>
                                </a>
                            </div>
                            <!-- Notification Modal -->
                            <div class="notif-overlay" id="notifOverlay" onclick="closeNotifModal()"></div>
                            <div class="notif-modal" id="notifModal">
                                <div class="notif-modal-header">
                                    <span class="notif-modal-title" data-i18n="notifications">Notifications</span>
                                    <div style="display:flex;align-items:center;gap:8px">
                                        <button class="notif-mark-all-btn" onclick="markAllReadModal()" id="markAllBtn" data-i18n="notif_mark_all_read">
                                            Mark all as read
                                        </button>
                                        <button class="notif-modal-close" onclick="closeNotifModal()">✕</button>
                                    </div>
                                </div>
                                <div class="notif-tabs">
                                    <button class="notif-tab notif-tab-active" id="tabAll" onclick="switchNotifTab('all')" data-i18n="notif_tab_all">All</button>
                                    <button class="notif-tab" id="tabUnread" onclick="switchNotifTab('unread')" data-i18n="notif_no_unread">
                                        Unread <span class="notif-tab-count" id="tabUnreadCount" style="display:none"></span>
                                    </button>
                                </div>
                                <div class="notif-modal-list" id="notifModalList">
                                    <div class="notif-modal-empty">Loading...</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="login-btn" onclick="openAuthModal('login')">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            <span data-i18n="sign_in_btn">Sign in</span>
                        </button>
                    }
                    <span class="divider">|</span>
                    <div class="lang-switcher">
                        <button class="lang-pill" id="headerLangEN" onclick="setLang('en')">EN</button>
                        <button class="lang-pill" id="headerLangLV" onclick="setLang('lv')">LV</button>
                        <button class="lang-pill" id="headerLangRU" onclick="setLang('ru')">RU</button>
                    </div>

                </div>

            </div>
        </nav>
    </div>

    @* ── Search bar ── *@
    <div class="header-search-bar">
        <div class="header-search-inner">

            <a asp-controller="Home" asp-action="Index" class="site-logo">
                <img src="/img/Logo.svg" alt="Linkora24" width="175" />
            </a>

            <button type="button" class="categories-btn" onclick="openCatMenu()">
                <img src="/img/search_for.svg" alt="" class="categories-icon" />
                <span data-i18n="all_categories">All categories</span>
            </button>

            <form class="search-form" onsubmit="handleGlobalSearch(event)">
                <div class="search-pill">
                    <input type="text" class="search-input"
                           name="search"
                           placeholder="Search..."
                           data-i18n-placeholder="search_placeholder"
                           aria-label="Search" />
                    <button type="submit" class="search-btn" data-i18n="search_btn">Search</button>
                </div>
            </form>

            @if (User.Identity?.IsAuthenticated == true)
            {
                var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (role != "banned")
                {
                    <a asp-controller="Product" asp-action="Create" class="header-post-btn">
                        <span data-i18n="post_ad_btn">+ Post an ad</span>
                    </a>
                }
                else
                {
                    <button type="button" class="header-post-btn" id="banned-btn" onclick="flashRed(this)">
                        <span data-i18n="post_ad_btn">+ Post an ad</span>
                    </button>

                    <script>
                        function flashRed(btn) {
                            btn.classList.add('flash-red');
                            setTimeout(() => btn.classList.remove('flash-red'), 500);
                        }
                    </script>
                }
            }
            else
            {
                <button type="button" class="header-post-btn" onclick="openAuthModal('login')">
                    <span data-i18n="post_ad_btn">+ Post an ad</span>
                </button>
            }
        </div>
    </div>

    @if (User.Identity!.IsAuthenticated)
    {
        <!-- Settings Modal (language section removed) -->
        <div class="modal-overlay" id="settingsOverlay" onclick="closeSettingsModal()"></div>
        <div class="modal" id="settingsModal" style="max-width:360px;width:360px;height:auto;min-height:unset;padding-bottom:24px">
            <button class="modal-close" onclick="closeSettingsModal()">✕</button>
            <h2 class="auth-title" data-i18n="settings_title">Settings</h2>

            <div class="settings-section">
                <div class="settings-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    </svg>
                    <span data-i18n="settings_dark">Dark mode</span>
                </div>
                <button class="settings-toggle" id="themeToggle" onclick="toggleTheme()">
                    <span class="settings-toggle-knob"></span>
                </button>
                <div class="settings-section">
                    <div class="settings-label">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <span data-i18n="profile_settings_link">Profile settings</span>
                    </div>
                    <a href="/Profile/Edit" onclick="closeSettingsModal()"
                       style="font-size:13px;color:#00b0a3;font-weight:600;text-decoration:none" data-i18n="profile_edit_title">
                        Edit →
                    </a>
                </div>
            </div>
        </div>

        <!-- Reviews Modal -->
        <div class="reviews-overlay" id="myReviewsOverlay" onclick="closeMyReviewsModal()"></div>
        <div class="reviews-modal" id="myReviewsModal">
            <div class="reviews-modal-header">
                <span class="reviews-modal-title" data-i18n="reviews_title">Reviews</span>
                <button class="reviews-modal-close" onclick="closeMyReviewsModal()">✕</button>
            </div>
            <div class="reviews-tabs">
                <button class="reviews-tab reviews-tab-active" id="tabAboutMe"
                        onclick="switchReviewTab('about')"
                        data-i18n="about_me_tab">
                    About me
                </button>
                <button class="reviews-tab" id="tabFromMe"
                        onclick="switchReviewTab('from')"
                        data-i18n="from_me_tab">
                    From me
                </button>
            </div>
            <div class="reviews-list" id="myReviewsList">
                <div class="reviews-empty" data-i18n="loading_text">Loading...</div>
            </div>
        </div>
    }

    <script>
        function applyTranslations() {
            const lang = localStorage.getItem('lang') || 'en';
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                const translation = translations[lang]?.[key];
                if (translation) {
                    if (el.tagName === 'INPUT' && el.getAttribute('data-i18n-placeholder') !== null) {
                        el.placeholder = translation;
                    } else {
                        el.innerText = translation;
                    }
                }
            });
        }

        function setLang(lang) {
            localStorage.setItem('lang', lang);
            document.cookie = `lang=${lang};path=/;max-age=31536000`;
            applyTranslations();

            document.querySelectorAll('.lang-pill').forEach(btn => btn.classList.remove('active'));
            if (lang === 'en') document.getElementById('headerLangEN')?.classList.add('active');
            if (lang === 'lv') document.getElementById('headerLangLV')?.classList.add('active');
            if (lang === 'ru') document.getElementById('headerLangRU')?.classList.add('active');

            const regionBtnLabel = document.getElementById('regionBtnLabel');
            if (regionBtnLabel && (regionBtnLabel.textContent === 'All regions' || regionBtnLabel.textContent === 'Visi reģioni' || regionBtnLabel.textContent === 'Все регионы')) {
                regionBtnLabel.textContent = t('all_regions');
            }
            location.reload();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark-theme');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            const themeToggleBtn = document.getElementById('themeToggle');
            if (themeToggleBtn) themeToggleBtn.classList.toggle('settings-toggle-on', isDark);
        }

        (function() {
            if (localStorage.getItem('theme') === 'dark')
                document.documentElement.classList.add('dark-theme');

            const currentLang = localStorage.getItem('lang') || 'en';
            if (currentLang === 'en') document.getElementById('headerLangEN')?.classList.add('active');
            if (currentLang === 'lv') document.getElementById('headerLangLV')?.classList.add('active');
            if (currentLang === 'ru') document.getElementById('headerLangRU')?.classList.add('active');
        })();

        function t(key) {
            const lang = localStorage.getItem('lang') || 'en';
            const local = translations[lang]?.[key];
            if (local) return local;
            if (typeof TRANSLATIONS !== 'undefined') {
                return TRANSLATIONS[lang]?.[key] || TRANSLATIONS.en?.[key] || key;
            }
            return key;
        }
        const translations = {
            en: {
                notif_fav_qty_changed: "Quantity: {0} → {1}",
                notif_fav_title_changed: "Title changed",
                notif_fav_address_changed: "Address: {0} → {1}",
                notif_fav_description_updated: "Description updated",
                notif_fav_price_changed: "Price: {0}€ → {1}€",
                notif_fav_characteristics_updated: "Characteristics updated",
                notif_subscription_seller_banned: "Seller {0} has been suspended",
                notif_favourite_archived_ban: "A listing in your favorites was archived due to seller suspension",
                notif_favourite_updated: 'Updated: {0}',
                notif_deal_sold: '{0} purchased your listing',
                notif_deal_bought: 'You purchased a listing from {0}',
                notif_review_received: '{0} left you a {1}★ review',
                notif_user_banned: 'Your account has been suspended',
                notif_user_unbanned: 'Your account suspension has been lifted',
                notif_report_on_product: 'A report was filed on your listing. Reason: {0}',
                notif_product_approved: 'Your listing was approved',
                notif_parameter_approved: 'Parameter "{0}" was approved',
                notif_parameter_rejected: 'Parameter "{0}" was rejected and listing blocked',
                notif_subscription_sold: '{0} sold their listing',
                notif_rejected_reason: "Your listing was rejected. Reason: {0}",
                notif_new_listing: "{0} posted a new listing: {1}",
                all_regions: "All regions",
                loading_text: "Loading...",
                no_reviews_yet: "No reviews yet.",
                failed_load: "Failed to load.",
                notifications: "Notifications",
                notif_no_unread: "Unread",
                notif_mark_all_read: "Mark all as read",
                settings_title: "Settings",
                settings_dark: "Dark mode",
                my_ads: "My ads",
                messages: "Messages",
                favourites: "Favourites",
                my_subscriptions: "My subscriptions",
                reviews: "Reviews",
                cart: "Cart",
                logout: "Logout",
                sign_in_btn: "Sign in",
                for_business: "For business",
                career: "Career",
                help: "Help",
                all_categories: "All categories",
                search_placeholder: "Search...",
                search_btn: "Search",
                post_ad_btn: "+ Post an ad",
                about_me_tab: "About me",
                from_me_tab: "From me",
                reviews_title: "Reviews",
                settings_language: "Language"
            },
            lv: {
                notif_fav_qty_changed: "Daudzums: {0} → {1}",
                notif_fav_title_changed: "Nosaukums mainīts",
                notif_fav_address_changed: "Adrese: {0} → {1}",
                notif_fav_description_updated: "Apraksts atjaunināts",
                notif_fav_price_changed: "Cena: {0}€ → {1}€",
                notif_fav_characteristics_updated: "Raksturlielumi atjaunināti",
                notif_subscription_seller_banned: "Pārdevējs {0} ir apturēts",
                notif_favourite_archived_ban: "Sludinājums no jūsu izlases ir arhivēts pārdevēja apturēšanas dēļ",
