@using Linkora.Models
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@{
    var category = (Category)ViewBag.Category;
    var breadcrumb = (List<Category>)ViewBag.Breadcrumb;
    var children = (List<Category>)ViewBag.Children;
    var products = (List<Linkora.Models.Product>)ViewBag.Products;
    var sort = (string)ViewBag.Sort;
    ViewData["Title"] = category.Name;
}

@await Html.PartialAsync("_Breadcrumb", breadcrumb.Skip(1).ToList())

@{
    var parent = breadcrumb.Count > 1 ? breadcrumb[breadcrumb.Count - 2] : null;
    var hasPriceSort = products.Any(p => p.Price.HasValue);
}

<div class="category-header">
    <h1 class="category-title">
        @category.Name
        <span class="category-count">@ViewBag.Total</span>
    </h1>
    @if (ViewBag.Search != null)
    {
        var removeUrl = Url.Action("Index", "Category", new
        {
            id = category.Id,
            sort = sort,
            city = (string?)ViewBag.City
        });
        <div style="margin-bottom: 12px;">
            <span class="search-chip">
                @ViewBag.Search
                <a class="search-chip-remove" href="@removeUrl">✕</a>
            </span>
        </div>
    }
</div>

<div class="category-body">
    <div class="category-left">
        <nav class="category-sidebar">
            @if (parent != null)
            {
                <a class="sidebar-parent"
                   asp-controller="Category" asp-action="Index" asp-route-id="@parent.Id">
                    &lt; @parent.Name
                </a>
            }
            <span class="sidebar-current">@category.Name</span>
            @foreach (var child in children)
            {
                <a class="sidebar-child"
                   asp-controller="Category" asp-action="Index" asp-route-id="@child.Id">
                    @child.Name
                </a>
            }
        </nav>

        @{
            var parameters = (List<Linkora.Models.Parameter>)ViewBag.Parameters;
            var activeFilters = (Dictionary<int, List<string>>)ViewBag.Filters;
            var activeRangeFrom = (Dictionary<int, decimal>)ViewBag.RangeFrom;
            var activeRangeTo = (Dictionary<int, decimal>)ViewBag.RangeTo;
        }
        @if (parameters.Count > 0)
        {
            <form method="get" id="filterForm" class="param-sidebar">
                <input type="hidden" name="id" value="@category.Id" />
                <input type="hidden" name="city" value="@(ViewBag.City ?? "")" />
                <input type="hidden" name="q" value="@(ViewBag.Search ?? "")" />

                @foreach (var vm in parameters)
                {
                    <div class="param-block" data-param="@vm.Param.Id">
                        @if (vm.Param.Type == 3)
                        {
                            <div class="param-check-row">
                                <span class="param-title">@vm.Param.Name</span>
                                <input type="checkbox" class="param-check-input"
                                       name="p_@vm.Param.Id" value="true"
                                       @(activeFilters.ContainsKey(vm.Param.Id) ? "checked" : "") />
                            </div>
                        }
                        else
                        {
                            <div class="param-title">@vm.Param.Name</div>
                        }
                        @if (vm.Param.Type == 2)
                        {
                            <div class="param-pills">
                                @for (int i = 0; i < vm.Options.Count; i++)
                                {
                                    var opt = vm.Options[i];
                                    var isActive = activeFilters.TryGetValue(vm.Param.Id, out var selVals)
                                    && selVals.Contains(opt.Id.ToString());
                                    <label class="param-pill @(isActive ? "param-pill-active" : "") @(i >= 5 ? "param-option-hidden" : "")"
                                           style="@(i >= 5 ? "display:none" : "")"
                                           data-id="@opt.Id"
                                           onclick="selectPill(this, '@vm.Param.Id'); ParamRulesEngine.triggerUpdate();">
                                        @opt.Text
                                    </label>
                                }
                            </div>
                            <input type="hidden" name="p_@vm.Param.Id" id="pill_@vm.Param.Id"
                                   value="@(activeFilters.TryGetValue(vm.Param.Id, out var pv) ? pv.FirstOrDefault() : "")" />
                            @if (vm.Options.Count > 5)
                            {
                                <button type="button" class="param-show-more"
                                        data-count="@(vm.Options.Count - 5)"
                                        onclick="toggleOptions(this)">
                                    More @(vm.Options.Count - 5)
                                </button>
                            }
                        }
                        @if (vm.Param.Type == 5)
                        {
                            var fFrom = activeRangeFrom.TryGetValue(vm.Param.Id, out var rf) ? rf.ToString(System.Globalization.CultureInfo.InvariantCulture) : "";
                            var fTo = activeRangeTo.TryGetValue(vm.Param.Id, out var rt) ? rt.ToString(System.Globalization.CultureInfo.InvariantCulture) : "";
                            <div class="param-range" data-min="@vm.Min" data-max="@vm.Max" data-step="@vm.Step">
                                <input type="number" class="param-range-input param-range-from"
                                       name="p_@(vm.Param.Id)_from"
                                       placeholder="@((double)(vm.Min ?? 0))"
                                       min="@vm.Min" max="@vm.Max" step="@vm.Step"
                                       value="@fFrom"
                                       onblur="rangeSync(this,'from')" />
                                <input type="number" class="param-range-input param-range-to"
                                       name="p_@(vm.Param.Id)_to"
                                       placeholder="@((double)(vm.Max ?? 0))"
                                       min="@vm.Min" max="@vm.Max" step="@vm.Step"
                                       value="@fTo"
                                       onblur="rangeSync(this,'to')" />
                            </div>
                        }
                        @if (vm.Param.Type == 4)
                        {
                            <div class="param-options">
                                @for (int i = 0; i < vm.Options.Count; i++)
                                {
                                    var opt = vm.Options[i];
                                    var isChecked = activeFilters.TryGetValue(vm.Param.Id, out var cv)
                                    && cv.Contains(opt.Id.ToString());
                                    <label class="param-option @(i >= 5 ? "param-option-hidden" : "")"
                                           style="@(i >= 5 ? "display:none" : "")">
                                        <input type="checkbox" name="p_@vm.Param.Id"
                                               value="@opt.Id"
                                               @(isChecked ? "checked" : "") />
                                        @opt.Text
                                    </label>
                                }
                            </div>
                            @if (vm.Options.Count > 5)
                            {
                                <button type="button" class="param-show-more"
                                        data-count="@(vm.Options.Count - 5)"
                                        onclick="toggleOptions(this)">
                                    More @(vm.Options.Count - 5)
                                </button>
                            }
                        }
                        @if (vm.Param.Type == 6)
                        {
                            activeFilters.TryGetValue(vm.Param.Id, out var sel6);
                            var selectedIds6 = new HashSet<string>(sel6 ?? new List<string>());

                            <div class="param-swatches" data-param="@vm.Param.Id">
                                @foreach (var opt in vm.ColorOptions)
                                {
                                    var isActive = selectedIds6.Contains(opt.Id.ToString());
                                    var isHidden = !opt.IsMain && !isActive;

                                    <label class="param-swatch-row @(isActive ? "param-swatch-active" : "") @(isHidden ? "param-swatch-hidden" : "")"
                                           data-id="@opt.Id"
                                           style="@(isHidden ? "display:none" : "")"
                                           onclick="selectSwatch(this, '@vm.Param.Id')">
                                        <span class="param-swatch-circle" style="background-color:@opt.HexValue"></span>
                                        <span class="param-swatch-name">@opt.Name</span>
                                    </label>
                                }

                                @{
                                    var hiddenCount6 = vm.ColorOptions.Count(c => !c.IsMain && !selectedIds6.Contains(c.Id.ToString()));
                                }
                                @if (hiddenCount6 > 0)
                                {
                                    <button type="button" class="param-show-more"
                                            data-count="@hiddenCount6"
                                            data-i18n="more_btn"
                                            onclick="toggleOptions(this)"></button>
                                }
                            </div>

                            <input type="hidden" name="p_@vm.Param.Id" id="swatch_@vm.Param.Id"
                                   value="@(sel6 != null && sel6.Count > 0 ? sel6.First() : "")" />
                        }
                        @if (vm.Param.Type == 8)
                        {
                            var activeIds = activeFilters.TryGetValue(vm.Param.Id, out var fv) ? fv : new List<string>();

                            <div class="free-text-select" data-param="@vm.Param.Id" style="position:relative">

                                <div class="free-text-chips" id="chips_@vm.Param.Id" style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px;">
                                    @foreach (var activeId in activeIds)
                                    {
                                        var opt = vm.Options.FirstOrDefault(o => o.Id.ToString() == activeId);
                                        var displayText = opt?.Text ?? activeId;

                                        <span class="search-chip" data-id="@activeId" style="margin: 0;">
                                            @displayText
                                            <a class="search-chip-remove" href="#" onclick="removeType8Chip(this); return false;">✕</a>
                                            <input type="hidden" name="p_@vm.Param.Id" value="@activeId" />
                                        </span>
                                    }
                                </div>

                                <input type="text" class="param-range-input free-text-select-input"
                                       data-param="@vm.Param.Id"
                                       value="" autocomplete="off"
                                       placeholder="Введите или выберите..."
                                       oninput="FreeTextSelect.onInput(this)"
                                       onfocus="FreeTextSelect.onFocus(this)"
                                       onkeydown="handleType8Keydown(event, '@vm.Param.Id')" />

                                <div class="create-dropdown free-text-select-drop"></div>
                            </div>
                        }
                    </div>
                }
                @if (parameters.Count > 0)
                {
                    <div id="floatingFilterActions" class="floating-filter-actions">
                        <button type="submit" class="param-apply-btn" data-i18n="apply_filters">Apply filters</button>
                        <button type="button" class="param-reset-btn" data-i18n="reset_filters" onclick="resetFilters(@category.Id)">Reset</button>
                    </div>
                }
            </form>
        }
    </div>
    <div class="category-content">
        <div class="listing-toolbar">
            <div class="listing-view-btns">
                <button class="listing-view-btn" id="btnGrid" onclick="setView('grid')" title="Grid" data-i18n-title="grid_view">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                </button>
                <button class="listing-view-btn" id="btnList" onclick="setView('list')" title="List" data-i18n-title="list_view">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
                </button>
                <button class="listing-view-btn" id="btnMap" onclick="setView('map')" title="Map" data-i18n-title="map_view">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" />
                        <line x1="8" y1="2" x2="8" y2="18" />
                        <line x1="16" y1="6" x2="16" y2="22" />
                    </svg>
                </button>
            </div>
            <button type="button" class="listing-region-btn" onclick="openRegionModal()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
                <span id="regionBtnLabel" data-i18n="@(ViewBag.City == null ? "all_regions" : null)">@(ViewBag.City != null ? (string)ViewBag.City : "All regions")</span>
            </button>
            <div class="listing-sort-wrap">
                <button class="listing-sort-btn" onclick="toggleSort(event)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6" /><line x1="7" y1="12" x2="21" y2="12" /><line x1="11" y1="18" x2="21" y2="18" /></svg>
                    <span id="sortLabel" data-sort="@sort"></span> ▾
                </button>
                <div class="listing-sort-drop" id="sortDrop">
                    <a class="listing-sort-item@(sort == "new" ? " active" : "")"
                       onclick="clientSort('new', this)" data-i18n="sort_newest"></a>
                    @if (hasPriceSort)
                    {
                        <a class="listing-sort-item@(sort == "cheap" ? " active" : "")"
                           onclick="clientSort('cheap', this)" data-i18n="sort_cheapest"></a>
                        <a class="listing-sort-item@(sort == "expensive" ? " active" : "")"
                           onclick="clientSort('expensive', this)" data-i18n="sort_expensive"></a>
                    }
                </div>
            </div>
        </div>

        <div class="listing-grid" id="listingContainer">
            @foreach (var p in products)
            {
                await Html.RenderPartialAsync("_ProductCard", new ProductCardViewModel { Product = p });
            }
        </div>
        <div class="listing-map" id="listingMap" style="display:none">
    <div id="productsMapCanvas" style="width:100%;height:600px;border-radius:12px"></div>
</div>
        @if ((int)ViewBag.TotalPages > 1)
{
    var currentPage = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var queryDict = new Dictionary<string, StringValues>(Context.Request.Query);
    queryDict.Remove("page");

    string GetPageUrl(int page)
    {
        queryDict["page"] = page.ToString();
        return Url.Action("Index", "Category", new { id = category.Id }) + QueryString.Create(queryDict).ToString();
    }

    <nav class="pagination">
        <ul class="pagination-list">
            @if (currentPage > 1)
            {
                <li><a class="page-link" href="@GetPageUrl(currentPage - 1)">←</a></li>
            }

            @{
                int around = 1;

                if (totalPages <= 2 * around)
                {
                    for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == currentPage)
                        {
                            <li><span class="page-link active">@i</span></li>
                        }
                        else
                        {
                            <li><a class="page-link" href="@GetPageUrl(i)">@i</a></li>
                        }
                    }
                }
                else
                {
                    if (currentPage == 1)
                    {
                        <li><span class="page-link active">1</span></li>
                    }
                    else
                    {
                        <li><a class="page-link" href="@GetPageUrl(1)">1</a></li>
                    }

                    if (currentPage > around + 2)
                    {
                        <li><span class="page-link dots">…</span></li>
                    }

                    int left = Math.Max(2, currentPage - around);
                    int right = Math.Min(totalPages - 1, currentPage + around);
                    for (int i = left; i <= right; i++)
                    {
                        if (i == currentPage)
                            {
                                <li><span class="page-link active">@i</span></li>
                            }
                        else
                            {
                                <li><a class="page-link" href="@GetPageUrl(i)">@i</a></li>
                            }
                    }

                    if (currentPage < totalPages - around - 1)
                    {
                        <li><span class="page-link dots">…</span></li>
                    }
                    if (currentPage == totalPages)
                    {
                        <li><span class="page-link active">@totalPages</span></li>
                    }
                    else
                    {
                        <li><a class="page-link" href="@GetPageUrl(totalPages)">@totalPages</a></li>
                    }
                }
            }

            @if (currentPage < totalPages)
            {
                <li><a class="page-link" href="@GetPageUrl(currentPage + 1)">→</a></li>
            }
        </ul>
    </nav>
}
</div>
</div>

<script src="https://maps.googleapis.com/maps/api/js?key=@Html.Raw(ViewBag.GoogleMapsApiKey)"></script>
<script src="~/js/markerclusterer.js"></script>
<script src="~/js/param-utils.js"></script>
<script>
    var mapProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        products.Select(p => new {
            id = p.Id, name = p.Name, price = p.Price, image = p.AvatarUrl ?? "/img/no-photo.svg",
            lat = p.Lat, lng = p.Lng
        })
    ));

    let mapsScriptLoading = null;
    function ensureMapsLoaded() {
        if (window.google && window.google.maps) return Promise.resolve();
        if (mapsScriptLoading) return mapsScriptLoading;
        mapsScriptLoading = new Promise((resolve) => {
            const script = document.createElement('script');
            script.src = 'https://maps.googleapis.com/maps/api/js?key=@Html.Raw(ViewBag.GoogleMapsApiKey)';
            script.onload = resolve;
            document.head.appendChild(script);
        });
    return mapsScriptLoading;
}

    function setView(v) {
        localStorage.setItem('listingView', v);
        const c = document.getElementById('listingContainer');
        c.className = v === 'grid' ? 'listing-grid' : 'listing-list';
        document.getElementById('btnGrid').classList.toggle('active', v === 'grid');
        document.getElementById('btnList').classList.toggle('active', v === 'list');
        if (v === 'map') {
        ensureMapsLoaded().then(loadProductsMap);
    }
    }

    function toggleSort(e) {
        e.stopPropagation();
        document.getElementById('sortDrop').classList.toggle('open');
    }

    function setSortLabel() {
        const sortLabel = document.getElementById('sortLabel');
        if (!sortLabel) return;
        const lang = localStorage.getItem('lang') || 'en';
        const dict = (typeof TRANSLATIONS !== 'undefined' && (TRANSLATIONS[lang] || TRANSLATIONS['en'])) || {};
        const sortMap = { new: dict.sort_newest, cheap: dict.sort_cheapest, expensive: dict.sort_expensive };
        sortLabel.textContent = sortMap[sortLabel.dataset.sort || 'new'] || dict.sort_newest || 'Newest first';
    }

    function initMoreButtons() {
        const lang = localStorage.getItem('lang') || 'en';
        const dict = (typeof TRANSLATIONS !== 'undefined' && (TRANSLATIONS[lang] || TRANSLATIONS['en'])) || {};
        document.querySelectorAll('.param-show-more').forEach(btn => {
            const block = btn.parentElement;
            const hidden = block.querySelectorAll('.param-option-hidden, .param-swatch-hidden');
            const count = hidden.length;
            btn.dataset.count = count;
            btn.textContent = (dict.more_btn || 'More') + ' ' + count;
        });
    }

let markerCluster = null;
let googleMap = null;
let productMarkers = [];
function loadProductsMap() {
    if (typeof google === 'undefined' || !google.maps) {
        setTimeout(loadProductsMap, 300);
        return;
    }

    if (!googleMap) {
        googleMap = new google.maps.Map(document.getElementById('productsMapCanvas'), {
            zoom: 12,
            center: { lat: 56.9496, lng: 24.1052 }
        });
    }

    if (markerCluster) {
        markerCluster.clearMarkers();
        markerCluster = null;
    }

    productMarkers.forEach(m => m.setMap(null));
    productMarkers = [];

    const markers = [];
    const bounds = new google.maps.LatLngBounds();
    let hasAny = false;

    mapProducts.forEach(p => {
        if (p.lat == null || p.lng == null) return;
        hasAny = true;
        const position = { lat: p.lat, lng: p.lng };

        const marker = new google.maps.AdvancedMarkerElement({ 
            position, 
            title: p.name,
        });

        const priceText = p.price ? p.price.toFixed(2) + ' €' : translate('price_on_request');
        const info = new google.maps.InfoWindow({
            content: `<a href="/Product/Details/${p.id}" style="text-decoration:none;color:#1a1a1a;display:block;width:140px">
                <img src="${p.image}" style="width:100%;height:90px;object-fit:cover;border-radius:6px" onerror="this.src='/img/no-photo.svg'" />
                <div style="font-weight:600;font-size:13px;margin-top:4px">${p.name}</div>
                <div style="font-size:13px;color:#00b0a3">${priceText}</div>
            </a>`
        });
        marker.addListener('click', () => info.open(googleMap, marker));

        markers.push(marker);
        productMarkers.push(marker);
        bounds.extend(position);
    });

    if (!hasAny) return;

    markerCluster = new MarkerClusterer({
        map: googleMap,
        markers: markers,
        gridSize: 60,           
        maxZoom: 16,            
        styles: [{
            url: '/img/cluster-icon.png', 
            height: 40,
            width: 40,
            textColor: '#fff',
            textSize: 14
        }]
    });

    googleMap.fitBounds(bounds);
}  

function resetFilters(categoryId) {
        window.location.href = '/Category/Index/' + categoryId;
    }

    function clientSort(type, el) {
        const lang = localStorage.getItem('lang') || 'en';
        const dict = (typeof TRANSLATIONS !== 'undefined' && (TRANSLATIONS[lang] || TRANSLATIONS['en'])) || {};

        document.querySelectorAll('.param-show-more[data-count]').forEach(btn => {
            btn.textContent = (dict.more_btn || 'More') + ' ' + btn.dataset.count;
        });
        document.querySelectorAll('.listing-sort-item').forEach(i => i.classList.remove('active'));
        el.classList.add('active');

        const labels = { new: dict.sort_newest, cheap: dict.sort_cheapest, expensive: dict.sort_expensive };
        document.getElementById('sortLabel').textContent = labels[type];
        document.getElementById('sortDrop').classList.remove('open');

        const container = document.getElementById('listingContainer');
        const cards = Array.from(container.children);

        cards.sort((a, b) => {
            const aTop = a.dataset.promoTop === 'true';
            const bTop = b.dataset.promoTop === 'true';
            if (aTop !== bTop) return aTop ? -1 : 1;

            if (type === 'new') {
                const da = a.querySelector('.product-card-date')?.textContent.trim() || '';
                const db = b.querySelector('.product-card-date')?.textContent.trim() || '';
                return db.localeCompare(da);
            }
            const pa = parseFloat(a.querySelector('.product-card-price-tag .price-value')?.textContent.replace(/[^0-9.]/g, '')) || 0;
            const pb = parseFloat(b.querySelector('.product-card-price-tag .price-value')?.textContent.replace(/[^0-9.]/g, '')) || 0;
            return type === 'cheap' ? pa - pb : pb - pa;
        });

        cards.forEach(c => container.appendChild(c));
    }

    document.addEventListener('click', e => {
        if (!e.target.closest('.listing-sort-wrap'))
            document.getElementById('sortDrop')?.classList.remove('open');
    });

    document.addEventListener('DOMContentLoaded', async () => {
        setView(localStorage.getItem('listingView') || 'grid');
        setSortLabel();

        if (typeof TRANSLATIONS === 'undefined') {
            const checkTranslations = setInterval(() => {
                if (typeof TRANSLATIONS !== 'undefined') {
                    clearInterval(checkTranslations);
                    initMoreButtons();
                }
            }, 50);
        } else initMoreButtons();

        const url = new URL(window.location.href);
        const city = url.searchParams.get('city');
        if (city) {
            document.querySelector('.regions-btn').innerHTML =
                '<img src="/img/marker_for_adv.svg" alt="" class="regions-icon" />' + city;
        }

        try {
            const res = await fetch('/Favourite/UserItems');
            if (res.ok) {
                const { favs, cart } = await res.json();
                document.querySelectorAll('.product-card-action-btn').forEach(btn => {
                    const onclickAttr = btn.getAttribute('onclick') || '';
                    const isFav = onclickAttr.includes('true');
                    const prodId = parseInt(onclickAttr.match(/\d+/)?.[0]);
                    if (isFav && favs.includes(prodId)) btn.classList.add('product-card-action-active');
                    if (!isFav && cart.includes(prodId)) btn.classList.add('product-card-action-active');
                });
            }
        } catch (e) {
            console.error(translate('failed_fetch_user_items'), e);
        }

        document.getElementById('filterForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            const form = this;

            const freeTextWraps = form.querySelectorAll('.free-text-select');
            for (const wrap of freeTextWraps) {
                const input = wrap.querySelector('.free-text-select-input');
                const text = input.value.trim();
                if (!text) continue;

                const paramId = wrap.dataset.param;
                try {
                    const res = await fetch('/Product/ResolveSelectOption', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.getElementById('afToken')?.value ?? ''
                        },
                        body: JSON.stringify({ paramId: paramId, text: text, createIfNotFound: false })
                    });
                    if (res.ok) {
                        const data = await res.json();
                        if (data && data.id) addType8Chip(paramId, data.id, text);
                    }
                } catch (err) {
                    console.error(translate('failed_resolve_filter'), err);
                }
            }

            const inputs = form.querySelectorAll('input, select');
            inputs.forEach(input => {
                if (input.type === 'checkbox' && !input.checked) input.disabled = true;
                else if (input.value.trim() === '') input.disabled = true;
            });

            form.submit();
        });

        if (window.ParamRulesEngine) {
            ParamRulesEngine.loadRules(@category.Id);
        }
    });
</script>
