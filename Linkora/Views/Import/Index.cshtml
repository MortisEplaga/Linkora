@{
    ViewData["Title"] = "Bulk import";
}
<div class="create-page">
    <h1 class="create-title" data-i18n="import_title">Bulk listing import</h1>

    <div class="create-section">
        <h2 class="create-section-title" data-i18n="import_step1_title">1. Template</h2>
        <div class="create-cat-selector" onclick="pickCategory()">
            <span id="impCatText" data-i18n="import_pick_category">Choose a category</span><span class="create-cat-arrow">›</span>
        </div>
        <input type="hidden" id="impCatId" />
        <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
            <button class="myads-action-btn" onclick="downloadTemplate('xlsx')" data-i18n="import_download_xlsx">Download XLSX</button>
            <button class="myads-action-btn" onclick="downloadTemplate('csv')" data-i18n="import_download_csv">Download CSV</button>
        </div>
        <p style="margin:12px 0 0;font-size:13px;line-height:1.5;color:#888" data-i18n="import_photos_hint">
            Photos: put direct links to images in the “photos” column, separated by “|” — they are downloaded to the server automatically.
        </p>
    </div>

    <div class="create-section">
        <h2 class="create-section-title" data-i18n="import_step2_title">2. Upload the filled file</h2>
        <input type="file" id="impFile" accept=".xlsx,.csv" />
        <button class="create-submit" style="margin-top:12px" onclick="uploadFile()" data-i18n="import_upload_btn">Upload</button>
        <div id="impResult" style="margin-top:12px;font-size:14px"></div>
    </div>

    <div class="create-section">
        <h2 class="create-section-title" data-i18n="import_export_title">3. Export current listings</h2>
        <p style="margin:0 0 12px;font-size:13px;line-height:1.5;color:#888" data-i18n="import_export_hint">
            Exports your active listings of the selected category in the same format, including photo links.
        </p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <button class="myads-action-btn" onclick="exportListings('xlsx')" data-i18n="import_export_xlsx">Export XLSX</button>
            <button class="myads-action-btn" onclick="exportListings('csv')" data-i18n="import_export_csv">Export CSV</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function pickCategory() {
            openCatMenu('select', c => {
                document.getElementById('impCatId').value = c.id;
                document.getElementById('impCatText').textContent = c.name;
            });
        }
        function requireCategory() {
            const id = document.getElementById('impCatId').value;
            if (!id) alert(translate('import_pick_category_first'));
            return id;
        }
        function downloadTemplate(format) {
            const id = requireCategory();
            if (!id) return;
            window.location.href = `/Import/Template?categoryId=${id}&format=${format}`;
        }
        function exportListings(format) {
            const id = requireCategory();
            if (!id) return;
            window.location.href = `/Import/Export?categoryId=${id}&format=${format}`;
        }
        async function uploadFile() {
            const file = document.getElementById('impFile').files[0];
            const out = document.getElementById('impResult');
            if (!file) { out.textContent = translate('import_file_required'); return; }
            const fd = new FormData();
            fd.append('file', file);
            out.textContent = translate('import_uploading');
            try {
                const res = await fetch('/Import/Upload', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': document.getElementById('afToken')?.value ?? '' },
                    body: fd
                });
                if (!res.ok) { out.textContent = `${translate('error')}: ${await res.text()}`; return; }
                const data = await res.json();
                if (data.errors.length) {
                    out.innerHTML = `<b>${escapeHtml(translate('import_result_failed'))}</b><br>` +
                        data.errors.map(e => `${escapeHtml(translate('import_row').replace('{0}', e.row))}: ${escapeHtml(e.message)}`).join('<br>');
                } else {
                    out.textContent = translate('import_result_created').replace('{0}', data.created);
                }
            } catch {
                out.textContent = translate('network_error');
            }
        }
        document.addEventListener('DOMContentLoaded', applyTranslations);
    </script>
}
