@{
    ViewData["Title"] = "Reset password";
}

<div class="auth-page">
    <div class="auth-card">
        <h2 class="auth-title" data-i18n="reset_password_title">Reset password</h2>

        @if (ViewBag.Invalid == true)
        {
            <div style="text-align:center;padding:8px 0 16px">
                <div style="font-size:40px;margin-bottom:12px">❌</div>
                <p style="color:#555;font-size:15px;line-height:1.6"
                   data-i18n="reset_password_invalid">
                    This link is invalid or has expired. Please request a new one.
                </p>
                <a asp-action="ForgotPassword"
                   style="color:#00b0a3;font-weight:600;text-decoration:none"
                   data-i18n="reset_password_request_new">
                    Request new link
                </a>
            </div>
        }
        else if (ViewBag.Success == true)
        {
            <div style="text-align:center;padding:8px 0 16px">
                <div style="font-size:40px;margin-bottom:12px">✅</div>
                <p style="color:#555;font-size:15px;line-height:1.6"
                   data-i18n="reset_password_success">
                    Password updated successfully. You can now sign in.
                </p>
                <a asp-action="Login"
                   style="color:#00b0a3;font-weight:600;text-decoration:none"
                   data-i18n="reset_password_sign_in">
                    Sign in
                </a>
            </div>
        }
        else
        {
            @if (ViewBag.Error != null)
            {
                <div class="auth-error">@ViewBag.Error</div>
            }

            <form method="post" asp-controller="Account" asp-action="ResetPassword">
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <div class="auth-field auth-field-password">
                    <input type="password" class="auth-input" name="password" id="resetPwd"
                           placeholder="New password"
                           data-i18n-placeholder="reset_password_new_ph"
                           required
                           oninput="checkResetStrength(this)" />
                    <button type="button" class="auth-eye"
                            onclick="togglePass('resetPwd', this)">
                        👁
                    </button>
                </div>

                <ul class="auth-rules" id="resetRules">
                    <li id="rr-len" data-i18n="auth_rule_len">At least 8 characters</li>
                    <li id="rr-upper" data-i18n="auth_rule_upper">Uppercase letter</li>
                    <li id="rr-lower" data-i18n="auth_rule_lower">Lowercase letter</li>
                    <li id="rr-digit" data-i18n="auth_rule_digit">Digit</li>
                </ul>

                <div class="auth-field auth-field-password">
                    <input type="password" class="auth-input" name="confirm" id="resetConfirm"
                           placeholder="Confirm new password"
                           data-i18n-placeholder="reset_password_confirm_ph"
                           required />
                    <button type="button" class="auth-eye"
                            onclick="togglePass('resetConfirm', this)">
                        👁
                    </button>
                </div>

                <button type="submit" class="auth-submit"
                        data-i18n="reset_password_btn">
                    Set new password
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        function checkResetStrength(input) {
            const v = input.value;
            const set = (id, ok) => document.getElementById(id)?.classList.toggle('auth-rule-ok', ok);
            set('rr-len',   v.length >= 8);
            set('rr-upper', /[A-Z]/.test(v));
            set('rr-lower', /[a-z]/.test(v));
            set('rr-digit', /[0-9]/.test(v));
        }
        document.addEventListener('DOMContentLoaded', applyTranslations);
    </script>
}