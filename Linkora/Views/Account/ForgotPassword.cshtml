@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-page">
    <div class="auth-card">
        <h2 class="auth-title" data-i18n="forgot_password_title">Forgot password</h2>

        @if (ViewBag.Sent == true)
        {
            <div style="text-align:center;padding:8px 0 16px">
                <div style="font-size:40px;margin-bottom:12px">✉️</div>
                <p style="color:#555;font-size:15px;line-height:1.6" data-i18n="forgot_password_sent">
                    If an account with that email exists, we sent a reset link. Check your inbox.
                </p>
                <a asp-action="Login"
                   style="color:#00b0a3;font-weight:600;text-decoration:none"
                   data-i18n="forgot_password_back">
                    Back to sign in
                </a>
            </div>
        }
        else
        {
            @if (ViewBag.Error != null)
            {
                <div class="auth-error">@ViewBag.Error</div>
            }

            <p style="color:#555;font-size:14px;margin-bottom:20px"
               data-i18n="forgot_password_desc">
                Enter your email address and we will send you a link to reset your password.
            </p>

            <form method="post">
                <input type="hidden" name="lang" id="forgotLangField" value="en" />
                <div class="auth-field">
                    <input type="email" class="auth-input" name="email"
                           placeholder="Email"
                           data-i18n-placeholder="email_placeholder"
                           required autofocus />
                </div>
                <button type="submit" class="auth-submit"
                        data-i18n="forgot_password_send_btn">
                    Send reset link
                </button>
            </form>

            <div style="text-align:center;margin-top:16px">
                <a asp-action="Login"
                   style="color:#00b0a3;font-size:14px;font-weight:600;text-decoration:none"
                   data-i18n="forgot_password_back">
                    Back to sign in
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            applyTranslations();
            const langField = document.getElementById('forgotLangField');
            if (langField) {
                langField.value = localStorage.getItem('lang') || 'en';
            }
        });
    </script>
}