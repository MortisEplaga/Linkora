@{
    ViewData["Title"] = "Sign in";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-tabs">
            <a class="auth-tab auth-tab-active" asp-controller="Account" asp-action="Login" data-i18n="sign_in_tab">Sign in</a>
            <a class="auth-tab" asp-controller="Account" asp-action="Register" data-i18n="register_tab">Register</a>
        </div>
        @if (ViewBag.Error != null)
        {
            <div class="auth-error">@ViewBag.Error</div>
        }

        <div class="auth-socials">
            <a class="auth-social auth-social-google"
               href="/Account/GoogleLogin?returnUrl=@Context.Request.Path"
               title="Sign in with Google"
               data-i18n-title="google_signin_title">
                <svg width="18" height="18" viewBox="0 0 48 48">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.36-8.16 2.36-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                    <path fill="none" d="M0 0h48v48H0z" />
                </svg>
            </a>
            <a class="auth-social auth-social-facebook" href="javascript:void(0);"
               onclick="loginWithFacebook('@Context.Request.Query["returnUrl"]')"
               title="Sign in with Facebook"
               data-i18n-title="facebook_signin_title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#1877f2">
                    <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879v-6.99h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.99C18.343 21.128 22 16.991 22 12z" />
                </svg>
            </a>
        </div>
        <div class="auth-divider"><span data-i18n="or_text">or</span></div>

        <form method="post" asp-controller="Account" asp-action="Login">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <input type="text" class="auth-input"
                   name="username"
                   placeholder="Username, email or phone"
                   autocomplete="username"
                   required
                   data-i18n-placeholder="login_username_placeholder" />
            <div class="auth-field auth-field-password">
                <input type="password" class="auth-input"
                       name="password"
                       id="modalLoginPassword"
                       placeholder="Password"
                       autocomplete="current-password"
                       required
                       data-i18n-placeholder="login_password_placeholder" />
                <button type="button" class="auth-eye"
                        onclick="togglePass('modalLoginPassword', this)">
                    👁
                </button>
            </div>
            <a class="auth-forgot" href="/Account/ForgotPassword" data-i18n="forgot_password_link">Forgot password?</a>
            <button type="submit" class="auth-submit" data-i18n="login_button">Sign in</button>
        </form>

        <div class="auth-footer">
            <span data-i18n="no_account_text">No account?</span>
            <a asp-controller="Account" asp-action="Register" data-i18n="register_link_footer">Register</a>
        </div>
    </div>
</div>