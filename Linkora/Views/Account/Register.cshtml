@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-tabs">
            <a class="auth-tab" asp-controller="Account" asp-action="Login" data-i18n="sign_in_tab">Sign in</a>
            <a class="auth-tab auth-tab-active" asp-controller="Account" asp-action="Register" data-i18n="register_tab">Register</a>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="auth-error">@ViewBag.Error</div>
        }

        <div class="auth-socials">
            <a class="auth-social auth-social-google"
               href="/Account/GoogleLogin"
               title="Sign up with Google">
                <svg width="18" height="18" viewBox="0 0 48 48">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.36-8.16 2.36-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                    <path fill="none" d="M0 0h48v48H0z" />
                </svg>
            </a>
            <a class="auth-social auth-social-facebook" href="javascript:void(0);"
               onclick="loginWithFacebook('@Context.Request.Query["returnUrl"]')"
               title="Sign in with Facebook">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#1877f2">
                    <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879v-6.99h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.99C18.343 21.128 22 16.991 22 12z" />
                </svg>
            </a>
        </div>
        <div class="auth-divider"><span data-i18n="or_text">or</span></div>

        <form method="post" asp-controller="Account" asp-action="Register">
            <div class="auth-type-row">
                <label class="auth-type-option">
                    <input type="radio" name="isCompany" value="false" checked />
                    <span class="auth-type-circle"></span>
                    <span data-i18n="account_type_private">Private</span>
                </label>
                <label class="auth-type-option">
                    <input type="radio" name="isCompany" value="true" />
                    <span class="auth-type-circle"></span>
                    <span data-i18n="account_type_business">Business</span>
                </label>
            </div>
            <div class="auth-type-hint" data-i18n="account_type_hint">You won't be able to change this later.</div>

            <div class="auth-field">
                <input type="text"
                       class="auth-input"
                       name="username"
                       placeholder="Username"
                       autocomplete="username"
                       required
                       data-i18n-placeholder="username_placeholder" />
            </div>

            <div class="auth-field">
                <input type="email"
                       class="auth-input"
                       name="email"
                       placeholder="Email"
                       autocomplete="email"
                       required
                       data-i18n-placeholder="email_placeholder" />
            </div>
            <div class="auth-field">
                <input type="tel"
                       class="auth-input"
                       name="phone"
                       placeholder="Phone"
                       autocomplete="tel"
                       data-i18n-placeholder="phone_placeholder" />
            </div>
            <div class="auth-field auth-field-password">
                <input type="password"
                       class="auth-input"
                       name="password"
                       id="regPwd"
                       placeholder="Password"
                       autocomplete="new-password"
                       oninput="checkStrength(this)"
                       minlength="8"
                       required
                       data-i18n-placeholder="password_placeholder" />
                <button type="button" class="auth-eye" onclick="togglePass('regPwd', this)">👁</button>
            </div>

            <ul class="auth-rules" id="passRules">
                <li id="rule-len" data-i18n="rule_length">At least 8 characters</li>
                <li id="rule-upper" data-i18n="rule_upper">Uppercase letter</li>
                <li id="rule-lower" data-i18n="rule_lower">Lowercase letter</li>
                <li id="rule-digit" data-i18n="rule_digit">Digit</li>
            </ul>

            <div class="auth-field auth-field-password">
                <input type="password"
                       class="auth-input"
                       name="confirm"
                       id="regConfirm"
                       placeholder="Confirm password"
                       autocomplete="new-password"
                       required
                       data-i18n-placeholder="confirm_placeholder" />
                <button type="button" class="auth-eye" onclick="togglePass('regConfirm', this)">👁</button>
            </div>

            <label class="auth-check-row">
                <input type="checkbox" id="chkTerms" required />
                <span data-i18n="accept_terms_prefix">I accept the </span>
                <a href="#" onclick="openTermsModal(); return false;" data-i18n="terms_link">Terms of Service</a>
            </label>

            <button type="submit" class="auth-submit" data-i18n="register_button">Register</button>
        </form>

        <div class="auth-footer">
            <span data-i18n="have_account_text">Already have an account?</span>
            <a asp-controller="Account" asp-action="Login" data-i18n="sign_in_link">Sign in</a>
        </div>
    </div>
</div>

<script>
    function togglePass(id, btn) {
        const input = document.getElementById(id);
        input.type = input.type === 'password' ? 'text' : 'password';
        btn.style.opacity = input.type === 'text' ? '0.4' : '1';
    }

    function checkStrength(input) {
        const v = input.value;
        toggle('rule-len',   v.length >= 8);
        toggle('rule-upper', /[A-Z]/.test(v));
        toggle('rule-lower', /[a-z]/.test(v));
        toggle('rule-digit', /[0-9]/.test(v));
    }

    function toggle(id, ok) {
        document.getElementById(id)?.classList.toggle('auth-rule-ok', ok);
    }
</script>
<script>
    window.fbAsyncInit = function() {
      FB.init({
        appId      : '837576922674717',
        cookie     : true,
        xfbml      : true,
        version    : 'v25.0'
      });

      FB.AppEvents.logPageView();

    };

    (function(d, s, id){
       var js, fjs = d.getElementsByTagName(s)[0];
       if (d.getElementById(id)) {return;}
       js = d.createElement(s); js.id = id;
       js.src = "https://connect.facebook.net/en_US/sdk.js";
       fjs.parentNode.insertBefore(js, fjs);
     }(document, 'script', 'facebook-jssdk'));
         function loginWithFacebook(returnUrl) {
        FB.login(function(response) {
            if (response.authResponse) {
                const accessToken = response.authResponse.accessToken;
                fetch('/Account/FacebookLogin', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.getElementById('afToken')?.value || ''
                    },
                    body: JSON.stringify({
                        accessToken: accessToken,
                        returnUrl: returnUrl || window.location.pathname
                    })
                })
                .then(res => {
                    if (res.ok) {
                        const url = res.url || returnUrl;
                        window.location.href = url || '/';
                    } else {
                        return res.text().then(err => { throw new Error(err) });
                    }
                })
                .catch(err => {
                    console.error('Facebook login failed', err);
                    alert('Ошибка входа через Facebook. Попробуйте позже.');
                });
            } else {
                console.log('Пользователь отменил вход');
            }
        }, { scope: 'public_profile,email' });
    }

    document.addEventListener('DOMContentLoaded', applyTranslations);
</script>