@{
    var user = (Linkora.Models.User)ViewBag.User;
    ViewData["Title"] = "Edit profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" />
    <style>
        .profile-page {
            max-width: 520px;
            margin: 40px auto;
            padding: 0 16px 48px;
        }

        .profile-card {
            background: #fff;
            border: 1px solid #e8e8e8;
            border-radius: 12px;
            padding: 32px;
        }

        .profile-title {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a1a;
            margin: 0 0 28px;
        }

        .profile-section-title {
            font-size: 13px;
            font-weight: 700;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin: 24px 0 12px;
            padding-top: 24px;
            border-top: 1px solid #f0f0f0;
        }

            .profile-section-title:first-of-type {
                margin-top: 0;
                padding-top: 0;
                border-top: none;
            }

        .profile-error {
            background: #fff0f0;
            border: 1px solid #ffcccc;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: #cc0000;
            margin-bottom: 16px;
            display: none;
        }

        .profile-success {
            background: #f0fff4;
            border: 1px solid #b2f0c8;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: #1a7f3c;
            margin-bottom: 16px;
            display: none;
        }

        .dark-theme .profile-card {
            background: #252525 !important;
            border-color: #333 !important;
        }

        .dark-theme .profile-title {
            color: #e8e8e8 !important;
        }

        .dark-theme .profile-section-title {
            color: #666 !important;
            border-top-color: #333 !important;
        }
    </style>
}

<div class="profile-page">
    <div class="profile-card">
        <h1 class="profile-title">Edit profile</h1>

        <div class="profile-error" id="profileError"></div>
        <div class="profile-success" id="profileSuccess">Saved successfully</div>

        <div class="profile-section-title">Basic information</div>

        <div class="auth-field">
            <label class="auth-label">Username</label>
            <input type="text" class="auth-input" id="fieldUserName" value="@user.UserName" />
        </div>

        <div class="auth-field">
            <label class="auth-label">Phone</label>
            <input type="tel" class="auth-input" id="fieldPhone"
                   value="@(user.PhoneNumber ?? "")" placeholder="+371 XXXXXXXX" />
        </div>

        <div class="auth-field">
            <label class="auth-label">Email</label>
            <input type="email" class="auth-input" value="@(user.Email ?? "")" disabled
                   style="opacity:0.5;cursor:default" title="Email cannot be changed" />
        </div>

        <div class="profile-section-title">Change password</div>

        <div class="auth-field auth-field-password">
            <label class="auth-label">Current password</label>
            <input type="password" class="auth-input" id="fieldCurrentPwd"
                   placeholder="Enter current password" />
            <button type="button" class="auth-eye" onclick="togglePass('fieldCurrentPwd',this)">👁</button>
        </div>

        <div class="auth-field auth-field-password">
            <label class="auth-label">New password</label>
            <input type="password" class="auth-input" id="fieldNewPwd"
                   placeholder="Leave blank to keep current"
                   oninput="checkStrengthProfile(this)" />
            <button type="button" class="auth-eye" onclick="togglePass('fieldNewPwd',this)">👁</button>
        </div>

        <ul class="auth-rules" id="profileRules" style="display:none">
            <li id="pr-len">At least 8 characters</li>
            <li id="pr-upper">Uppercase letter</li>
            <li id="pr-lower">Lowercase letter</li>
            <li id="pr-digit">Digit</li>
        </ul>

        <div class="profile-section-title">Interface</div>

        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <label class="auth-label" style="margin:0">Dark mode</label>
            <button class="settings-toggle" id="profileThemeToggle" onclick="toggleThemeProfile()">
                <span class="settings-toggle-knob"></span>
            </button>
        </div>

        <div style="display:flex;align-items:center;justify-content:space-between">
            <label class="auth-label" style="margin:0">Language</label>
            <div class="settings-lang-pills">
                <button class="settings-lang-pill" id="plEN" onclick="setLangProfile('en')">EN</button>
                <button class="settings-lang-pill" id="plLV" onclick="setLangProfile('lv')">LV</button>
                <button class="settings-lang-pill" id="plRU" onclick="setLangProfile('ru')">RU</button>
            </div>
        </div>

        <button class="auth-submit" style="margin-top:28px" onclick="saveProfile()">Save</button>
    </div>
</div>

@section Scripts {
    <script>
        // Инициализация UI
        (function () {
            const dark = localStorage.getItem('theme') === 'dark';
            const toggle = document.getElementById('profileThemeToggle');
            if (dark) toggle.classList.add('settings-toggle-on');

            const lang = localStorage.getItem('lang') || 'en';
            document.getElementById('pl' + lang.toUpperCase())?.classList.add('settings-lang-pill-active');
        })();

        function toggleThemeProfile() {
            const isDark = document.documentElement.classList.toggle('dark-theme');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            document.getElementById('profileThemeToggle').classList.toggle('settings-toggle-on', isDark);
        }

        function setLangProfile(lang) {
            localStorage.setItem('lang', lang);
            document.cookie = `lang=${lang};path=/;max-age=31536000`;
            document.querySelectorAll('.settings-lang-pill').forEach(b => b.classList.remove('settings-lang-pill-active'));
            document.getElementById('pl' + lang.toUpperCase())?.classList.add('settings-lang-pill-active');
            location.reload();
        }

        function togglePass(id, btn) {
            const input = document.getElementById(id);
            input.type = input.type === 'password' ? 'text' : 'password';
            btn.style.opacity = input.type === 'text' ? '0.4' : '1';
        }

        function checkStrengthProfile(input) {
            const v = input.value;
            const rules = document.getElementById('profileRules');
            rules.style.display = v.length ? 'flex' : 'none';
            const set = (id, ok) => document.getElementById(id)?.classList.toggle('auth-rule-ok', ok);
            set('pr-len',   v.length >= 8);
            set('pr-upper', /[A-Z]/.test(v));
            set('pr-lower', /[a-z]/.test(v));
            set('pr-digit', /[0-9]/.test(v));
        }

        async function saveProfile() {
            const errorEl   = document.getElementById('profileError');
            const successEl = document.getElementById('profileSuccess');
            errorEl.style.display   = 'none';
            successEl.style.display = 'none';

            const payload = {
                userName:        document.getElementById('fieldUserName').value.trim(),
                phone:           document.getElementById('fieldPhone').value.trim() || null,
                currentPassword: document.getElementById('fieldCurrentPwd').value || null,
                newPassword:     document.getElementById('fieldNewPwd').value || null,
            };

            const res = await fetch('/Profile/Save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.getElementById('afToken')?.value ?? ''
                },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                successEl.style.display = 'block';
                document.getElementById('fieldCurrentPwd').value = '';
                document.getElementById('fieldNewPwd').value = '';
                document.getElementById('profileRules').style.display = 'none';
            } else {
                const data = await res.json();
                const msgs = data.errors?.join(', ') || 'Error saving profile';
                errorEl.textContent    = msgs;
                errorEl.style.display  = 'block';
            }
        }
    </script>
}