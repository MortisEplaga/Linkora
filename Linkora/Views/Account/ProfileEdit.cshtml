@{
    var user = (Linkora.Models.User)ViewBag.User;
    ViewData["Title"] = "Edit profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" />
    <style>
        .profile-page {
            max-width: 520px;
            margin: 40px auto;
            padding: 0 16px 48px;
        }

        .profile-card {
            background: #fff;
            border: 1px solid #e8e8e8;
            border-radius: 12px;
            padding: 32px;
        }

        .profile-title {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a1a;
            margin: 0 0 28px;
        }

        .profile-section-title {
            font-size: 13px;
            font-weight: 700;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin: 24px 0 12px;
            padding-top: 24px;
            border-top: 1px solid #f0f0f0;
        }

            .profile-section-title:first-of-type {
                margin-top: 0;
                padding-top: 0;
                border-top: none;
            }

        .profile-error {
            background: #fff0f0;
            border: 1px solid #ffcccc;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: #cc0000;
            margin-bottom: 16px;
            display: none;
        }

        .profile-success {
            background: #f0fff4;
            border: 1px solid #b2f0c8;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: #1a7f3c;
            margin-bottom: 16px;
            display: none;
        }

        .profile-card .auth-field-password {
            position: relative;
        }

            .profile-card .auth-field-password .auth-input {
                padding-right: 42px;
            }

            .profile-card .auth-field-password .auth-eye {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-0%);
                background: transparent;
                border: none;
                cursor: pointer;
                font-size: 1.2rem;
                padding: 0;
                margin: 0;
                line-height: 1;
                color: #888;
                transition: opacity 0.2s;
            }

        .duration-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 4px;
        }

        .duration-pill {
            padding: 7px 16px;
            border-radius: 20px;
            border: 1px solid #ddd;
            background: #fff;
            font-size: 14px;
            font-weight: 500;
            color: #555;
            cursor: pointer;
            transition: background 0.15s, border-color 0.15s, color 0.15s;
        }

            .duration-pill:hover {
                border-color: #aaa;
                color: #1a1a1a;
            }

            .duration-pill.active {
                background: #1a1a1a;
                border-color: #1a1a1a;
                color: #fff;
            }

        .duration-hint {
            font-size: 12px;
            color: #aaa;
            margin-top: 6px;
        }

        .dark-theme .profile-card {
            background: #252525 !important;
            border-color: #333 !important;
        }

        .dark-theme .profile-title {
            color: #e8e8e8 !important;
        }

        .dark-theme .profile-section-title {
            color: #666 !important;
            border-top-color: #333 !important;
        }

        .dark-theme .profile-error {
            background: #2a1a1a !important;
            border-color: #5a2a2a !important;
            color: #ff8080 !important;
        }

        .dark-theme .profile-success {
            background: #1a2a1f !important;
            border-color: #2a5a3a !important;
            color: #6fcf97 !important;
        }

        .dark-theme .duration-pill {
            background: #2a2a2a !important;
            border-color: #444 !important;
            color: #888 !important;
        }

            .dark-theme .duration-pill.active {
                background: #e8e8e8 !important;
                border-color: #e8e8e8 !important;
                color: #1a1a1a !important;
            }
    </style>
}

<div class="profile-page">
    <div class="profile-card">
        <h1 class="profile-title" data-i18n="profile_edit_title">Edit profile</h1>

        <div class="profile-error" id="profileError"></div>
        <div class="profile-success" id="profileSuccess" data-i18n="profile_saved">Saved successfully</div>

        <div class="profile-section-title" data-i18n="profile_basic_info">Basic information</div>

        <div class="auth-field">
            <label class="auth-label" data-i18n="profile_username_label">Username</label>
            <input type="text" class="auth-input" id="fieldUserName" value="@user.UserName" />
        </div>

        <div class="auth-field">
            <label class="auth-label" data-i18n="profile_phone_label">Phone</label>
            <input type="tel" class="auth-input" id="fieldPhone"
                   value="@(user.PhoneNumber ?? "")" placeholder="+371 XXXXXXXX" />
        </div>

        <div class="auth-field">
            <label class="auth-label" data-i18n="profile_email_label">Email</label>
            <input type="email" class="auth-input" value="@(user.Email ?? "")" disabled
                   style="opacity:0.5;cursor:default" />
        </div>

        <div class="profile-section-title" data-i18n="profile_change_password">Change password</div>

        <div class="auth-field auth-field-password">
            <label class="auth-label" data-i18n="profile_current_pwd">Current password</label>
            <input type="password" class="auth-input" id="fieldCurrentPwd"
                   data-i18n-placeholder="profile_current_pwd_ph"
                   placeholder="Enter current password" />
            <button type="button" class="auth-eye" onclick="togglePass('fieldCurrentPwd',this)">👁</button>
        </div>

        <div class="auth-field auth-field-password">
            <label class="auth-label" data-i18n="profile_new_pwd">New password</label>
            <input type="password" class="auth-input" id="fieldNewPwd"
                   data-i18n-placeholder="profile_new_pwd_ph"
                   placeholder="Leave blank to keep current"
                   oninput="checkStrengthProfile(this)" />
            <button type="button" class="auth-eye" onclick="togglePass('fieldNewPwd',this)">👁</button>
        </div>

        <ul class="auth-rules" id="profileRules" style="display:none">
            <li id="pr-len" data-i18n="auth_rule_len">At least 8 characters</li>
            <li id="pr-upper" data-i18n="auth_rule_upper">Uppercase letter</li>
            <li id="pr-lower" data-i18n="auth_rule_lower">Lowercase letter</li>
            <li id="pr-digit" data-i18n="auth_rule_digit">Digit</li>
        </ul>

        <div class="profile-section-title" data-i18n="profile_interface">Interface</div>

        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <label class="auth-label" style="margin:0" data-i18n="profile_dark_mode">Dark mode</label>
            <button class="settings-toggle" id="profileThemeToggle" onclick="toggleThemeProfile()">
                <span class="settings-toggle-knob"></span>
            </button>
        </div>

        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
            <label class="auth-label" style="margin:0" data-i18n="profile_language">Language</label>
            <div class="settings-lang-pills">
                <button class="settings-lang-pill" id="plEN" onclick="setLangProfile('en')">EN</button>
                <button class="settings-lang-pill" id="plLV" onclick="setLangProfile('lv')">LV</button>
                <button class="settings-lang-pill" id="plRU" onclick="setLangProfile('ru')">RU</button>
            </div>
        </div>

        <!-- Ad duration preference -->
        <div class="auth-field">
            <label class="auth-label" data-i18n="profile_ad_duration">Preferred ad duration</label>
            <div class="duration-pills" id="durationPills">
                @foreach (var days in new[] { 1, 3, 7, 14, 30 })
                {
                    var isActive = user.PreferredAdDuration == days;
                    <button type="button"
                            class="duration-pill @(isActive ? "active" : "")"
                            data-days="@days"
                            onclick="selectDuration(@days, this)">
                        @days days
                    </button>
                }
            </div>
            <div class="duration-hint" data-i18n="profile_ad_duration_hint">
                Applied by default when posting an ad. If not set, 30 days is used.
            </div>
            <input type="hidden" id="fieldAdDuration" value="@(user.PreferredAdDuration?.ToString() ?? "")" />
        </div>
        <div class="profile-section-title" data-i18n="profile_subscription_title">Subscription</div>

        <div class="auth-field">
            <label class="auth-label" data-i18n="profile_subscription_label">Subscription plan</label>
            <div class="duration-pills" id="subscriptionPills">
                @foreach (var plan in new[] { "Free", "Standard", "Premium" })
                {
                    var isActive = user.SubscriptionType == plan;
                    <button type="button"
                            class="duration-pill @(isActive ? "active" : "")"
                            data-type="@plan"
                            onclick="selectSubscription('@plan', this)"
                            data-i18n="sub_plan_@(plan.ToLower())">
                        @plan
                    </button>
                }
            </div>
            <div class="duration-hint" data-i18n="profile_subscription_hint">
                Placeholder section. Plan benefits will be defined later.
            </div>
            <input type="hidden" id="fieldSubscriptionType" value="@user.SubscriptionType" />
        </div>

        <button class="auth-submit" style="margin-top:28px"
                data-i18n="profile_save_btn"
                onclick="saveProfile()">
            Save
        </button>
    </div>
    <div class="modal-overlay" id="subRulesOverlay" onclick="closeSubRulesModal()"></div>
    <div class="modal info-modal" id="subRulesModal">
        <button class="modal-close" onclick="closeSubRulesModal()">✕</button>
        <h2 class="info-modal-title" data-i18n="sub_rules_title">Subscription rules</h2>
        <div class="info-modal-body" id="subRulesBody" onscroll="checkSubRulesScroll()"></div>
        <div style="display:flex;gap:10px;padding:16px 24px 24px;flex-shrink:0">
            <button class="auth-submit" id="subAgreeBtn" disabled onclick="confirmSubRules(true)" data-i18n="promo_rules_agree">I agree — proceed to payment</button>
            <button class="auth-submit auth-submit-secondary" id="subDisagreeBtn" disabled onclick="confirmSubRules(false)" data-i18n="promo_rules_disagree">I disagree — continue without promotion</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const dark = localStorage.getItem('theme') === 'dark';
            document.getElementById('profileThemeToggle').classList.toggle('settings-toggle-on', dark);
            const lang = localStorage.getItem('lang') || 'en';
            document.getElementById('pl' + lang.toUpperCase())?.classList.add('settings-lang-pill-active');
        })();

        function toggleThemeProfile() {
            const isDark = document.documentElement.classList.toggle('dark-theme');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            document.getElementById('profileThemeToggle').classList.toggle('settings-toggle-on', isDark);
        }

        function setLangProfile(lang) {
            localStorage.setItem('lang', lang);
            document.cookie = `lang=${lang};path=/;max-age=31536000`;
            document.querySelectorAll('.settings-lang-pill').forEach(b => b.classList.remove('settings-lang-pill-active'));
            document.getElementById('pl' + lang.toUpperCase())?.classList.add('settings-lang-pill-active');
            location.reload();
        }

        function togglePass(id, btn) {
            const input = document.getElementById(id);
            input.type = input.type === 'password' ? 'text' : 'password';
            btn.style.opacity = input.type === 'text' ? '0.4' : '1';
        }
                let pendingSubType = null;
        let pendingSubBtn = null;

        function selectSubscription(type, btn) {
            if (type === 'Free') {
                applySubscriptionSelection(type, btn);
                return;
            }
            pendingSubType = type;
            pendingSubBtn = btn;
            openSubRulesModal();
        }

        function applySubscriptionSelection(type, btn) {
            document.querySelectorAll('#subscriptionPills .duration-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('fieldSubscriptionType').value = type;
        }

        function openSubRulesModal() {
            const body = document.getElementById('subRulesBody');
            const source = document.querySelector('#termsModal .info-modal-body');
            if (source) body.innerHTML = source.innerHTML;

            const lang = localStorage.getItem('lang') || 'en';
            body.querySelectorAll('.info-lang-content').forEach(el => {
                el.style.display = el.dataset.lang === lang ? '' : 'none';
            });

            const agreeBtn = document.getElementById('subAgreeBtn');
            const disagreeBtn = document.getElementById('subDisagreeBtn');
            agreeBtn.disabled = true;
            disagreeBtn.disabled = true;
            body.scrollTop = 0;

            document.getElementById('subRulesOverlay').classList.add('modal-open');
            document.getElementById('subRulesModal').classList.add('modal-open');
            document.body.style.overflow = 'hidden';

            setTimeout(() => {
                if (body.scrollHeight <= body.clientHeight + 10) {
                    agreeBtn.disabled = false;
                    disagreeBtn.disabled = false;
                }
            }, 50);
        }

        function checkSubRulesScroll() {
            const body = document.getElementById('subRulesBody');
            const atBottom = body.scrollTop + body.clientHeight >= body.scrollHeight - 10;
            if (atBottom) {
                document.getElementById('subAgreeBtn').disabled = false;
                document.getElementById('subDisagreeBtn').disabled = false;
            }
        }

        function closeSubRulesModal() {
            document.getElementById('subRulesOverlay').classList.remove('modal-open');
            document.getElementById('subRulesModal').classList.remove('modal-open');
            document.body.style.overflow = '';
        }

        function confirmSubRules(agreed) {
            closeSubRulesModal();
            if (agreed && pendingSubType) {
                applySubscriptionSelection(pendingSubType, pendingSubBtn);
            }
            pendingSubType = null;
            pendingSubBtn = null;
        }
        function checkStrengthProfile(input) {
            const v = input.value;
            document.getElementById('profileRules').style.display = v.length ? 'flex' : 'none';
            const set = (id, ok) => document.getElementById(id)?.classList.toggle('auth-rule-ok', ok);
            set('pr-len',   v.length >= 8);
            set('pr-upper', /[A-Z]/.test(v));
            set('pr-lower', /[a-z]/.test(v));
            set('pr-digit', /[0-9]/.test(v));
        }

        function selectDuration(days, btn) {
            document.querySelectorAll('#durationPills .duration-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('fieldAdDuration').value = days;
        }

        function selectSubscription(type, btn) {
            document.querySelectorAll('#subscriptionPills .duration-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('fieldSubscriptionType').value = type;
        }

        async function saveProfile() {
            const errorEl   = document.getElementById('profileError');
            const successEl = document.getElementById('profileSuccess');
            errorEl.style.display   = 'none';
            successEl.style.display = 'none';

            const durationVal = document.getElementById('fieldAdDuration').value;

            const payload = {
                userName:            document.getElementById('fieldUserName').value.trim(),
                phone:               document.getElementById('fieldPhone').value.trim() || null,
                currentPassword:     document.getElementById('fieldCurrentPwd').value || null,
                newPassword:         document.getElementById('fieldNewPwd').value || null,
                preferredAdDuration: durationVal ? parseInt(durationVal) : null,
                subscriptionType:    document.getElementById('fieldSubscriptionType').value || null,
            };

            const res = await fetch('/Profile/Save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.getElementById('afToken')?.value ?? ''
                },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                successEl.style.display = 'block';
                document.getElementById('fieldCurrentPwd').value = '';
                document.getElementById('fieldNewPwd').value = '';
                document.getElementById('profileRules').style.display = 'none';
            } else {
                const data = await res.json();
                errorEl.textContent   = data.errors?.join(', ') || 'Error saving profile';
                errorEl.style.display = 'block';
            }
        }
    </script>
}
