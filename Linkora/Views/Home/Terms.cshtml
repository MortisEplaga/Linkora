<script>
    function switchTermsLang(lang) {
        document.querySelectorAll('.terms-lang-btn').forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');
        document.querySelectorAll('.terms-content').forEach(content => {
            content.style.display = content.dataset.lang === lang ? 'block' : 'none';
        });
    }
</script>

